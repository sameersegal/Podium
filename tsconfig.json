{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types", "vitest/globals"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@podiumconf/domain/*": ["packages/domain/src/*"],
      "@podiumconf/data/*": ["packages/data/src/*"],
      "@podiumconf/plugins/*": ["packages/plugins/src/*"],
      "@podiumconf/web/*": ["workers/api/src/*"]
    }
  },
  "include": ["packages/**/*.ts", "workers/**/*.ts", "tests/**/*.ts", "worker-configuration.d.ts"],
  "exclude": ["node_modules", ".wrangler"]
}
