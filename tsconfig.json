{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types", "vitest/globals"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    // Relative, and no `baseUrl`: TypeScript 7 removed the option and rejects a
    // non-relative path target. `./` resolves against this file's directory,
    // which is what `baseUrl: "."` meant here anyway, so the mapping is
    // unchanged — it just also compiles under 5.x, which is why it is safe to
    // land alongside the bump rather than ahead of it.
    "paths": {
      "@podiumstack/domain/*": ["./packages/domain/src/*"],
      "@podiumstack/data/*": ["./packages/data/src/*"],
      "@podiumstack/plugins/*": ["./packages/plugins/src/*"],
      "@podiumstack/web/*": ["./workers/api/src/*"]
    }
  },
  "include": ["packages/**/*.ts", "workers/**/*.ts", "tests/**/*.ts", "worker-configuration.d.ts"],
  "exclude": ["node_modules", ".wrangler"]
}
