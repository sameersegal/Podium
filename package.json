{
  "name": "@podiumstack/podium",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Podium — an open-source SessionBoard alternative for AI Engineer-style conferences",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:only": "node scripts/dev.mjs --no-reset",
    "db:migrate": "wrangler d1 migrations apply podium --local",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/reset-db.mjs && npm run db:migrate && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "drift": "python3 .claude/skills/domain-drift/scripts/model_inventory.py --check",
    "security": "python3 .claude/skills/security-audit/scripts/attack_surface.py --check",
    "security:semgrep": "semgrep scan --metrics=off --config .claude/skills/security-audit/rules/ --exclude=node_modules --exclude=www --exclude=.wrangler",
    "plugin:endpoints": "node claude-plugin/scripts/build-endpoints.mjs",
    "plugin:check": "node claude-plugin/scripts/build-endpoints.mjs --check",
    "smoke": "node scripts/smoke.mjs",
    "perf": "node scripts/perf-console.mjs",
    "perf:scale": "node scripts/perf-seed-scale.mjs",
    "dev:lan": "node scripts/dev.mjs --host 0.0.0.0",
    "deploy:config": "node scripts/deploy-config.mjs",
    "seed:production": "npm run deploy:config && node scripts/seed.mjs --remote && node scripts/seed-assets.mjs --remote && node scripts/seed-publish.mjs",
    "deploy:migrate": "npm run deploy:config && wrangler d1 migrations apply podium --remote -c wrangler.production.jsonc",
    "deploy": "npm run deploy:config && wrangler deploy -c wrangler.production.jsonc"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0"
  }
}
