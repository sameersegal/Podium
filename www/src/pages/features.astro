---
import Base from "../layouts/Base.astro";
import Anchor from "../components/Anchor.astro";
import Cta from "../components/Cta.astro";
import PageHead from "../components/PageHead.astro";
import Shot from "../components/Shot.astro";
import { GITHUB_URL } from "../consts";

/*
 * For the program chair who has decided the problem is real and now wants to
 * see whether the product actually does it. Six screens in the order the year
 * runs — call, review, decide, onboard, place, publish — then the parts that
 * never make a demo but decide whether March is survivable.
 *
 * One primary action, at the bottom: go and use it.
 */

/** The parts nobody demos. Each is built; none of them is a screenshot. */
const alsoInTheBox = [
  {
    title: "Submission forms that survive a deadline",
    body: "Multi-step, with your own fields and saved drafts. The deadline closes the form; it does not trust people not to notice.",
  },
  {
    title: "Content approval with a history",
    body: "Edit an approved session and the approval is revoked and the previous version kept, in the same write. Nobody quietly changes a title after the programme is printed.",
  },
  {
    title: "Campaigns with an auditable outbox",
    body: "Compose to a segment — everyone rejected, everyone with a task overdue, every sponsor contact. Every message sent is recorded against the person who got it.",
  },
  {
    title: "Import that previews before it writes",
    body: "Bring last year's speakers in as a CSV and see what will be created, updated and rejected first. Everything comes back out as CSV, JSON or a ZIP of the files, with no export ticket to raise.",
  },
  {
    title: "An event roster",
    body: "Who is staff, who is a reviewer, who is a speaker, per event. Someone who chaired review last year is a submitter this year, and the tool should not need telling twice.",
  },
  {
    title: "A cross-event speaker directory",
    body: "Every edition you run here, in one searchable directory with tags, companies and history. What a conference compounds is the people it knows.",
  },
];
---

<Base
  title="Features"
  description="The six screens that run a conference program — call for proposals, review, decisions, speaker onboarding, the agenda and the published schedule — photographed on the running product."
>
  <PageHead
    eyebrow="The tour"
    title="Six screens, doing the six jobs."
    lede="Every image here is a photograph of Podium running against its own seeded conference: proposals in every state, a review round with real scores, sponsors part-way through their entitlements, an agenda with conflicts. Nothing is a mockup."
  >
    <div class="actions">
      <a class="btn primary" href="/demo">Run the demo</a>
      <a class="btn secondary" href={GITHUB_URL}>Get the source</a>
    </div>
  </PageHead>

  <section>
    <div class="wrap">
      <div class="feature" id="cfp">
        <div class="copy">
          <h3>A call for proposals people can finish.<Anchor for="cfp" label="A call for proposals people can finish" /></h3>
          <p>
            Multi-step forms with your own fields, and drafts a submitter can leave and come back
            to. One board shows every proposal, its state and its reviews at once, filterable and
            bulk-actionable.
          </p>
          <p>Two organizers working that board see each other's changes as they land.</p>
        </div>
        <Shot
          name="proposals"
          height={1140}
          url="app.podiumstack.com/admin/events/…/proposals"
          alt="The proposal board: thirteen proposals in a filterable table showing reference, title, state — accepted, draft, submitted, in review, rejected, waitlisted — track, format, speakers, reviews received and submission date."
        />
      </div>

      <div class="feature flip" id="review">
        <div class="copy">
          <h3>Review that holds up when someone asks.<Anchor for="review" label="Review that holds up when someone asks" /></h3>
          <p>
            Reviewers get a queue, a rubric and a progress bar. Not a shared sheet with a hundred
            rows. A reviewer who submitted, is credited on, or has declared a conflict with a
            proposal cannot score it — the write is refused, not logged for someone to notice.
          </p>
          <p>
            Run it open, single-blind or double-blind. Every score, comment and decision is
            recorded, so "why was this rejected" has an answer a year later.
          </p>
          <p>
            An optional first-pass triage sorts the pile before humans see it. It is off unless you
            turn it on, and its opinions never count toward quorum.
          </p>
        </div>
        <Shot
          name="review"
          height={840}
          url="app.podiumstack.com/review"
          alt="A reviewer's queue: a progress bar reading 7 of 7 done, over a card per assigned proposal with its reference, title, track, format, status and due date."
        />
      </div>

      <div class="feature" id="decisions">
        <div class="copy">
          <h3>Decide as a batch. Tell everyone at once.<Anchor for="decisions" label="Decide as a batch. Tell everyone at once" /></h3>
          <p>
            Outcomes stay provisional until you publish them. Nothing reaches a speaker early, and
            nobody finds out from a friend.
          </p>
          <p>
            Before you commit, Podium shows which proposals reached quorum and which are short of
            it. Decide anyway and it records who waived it, and why.
          </p>
        </div>
        <Shot
          name="decisions"
          height={1050}
          url="app.podiumstack.com/admin/events/…/decisions"
          alt="The decisions screen: proposals with quorum badges, an outcome, and a publication status, each with controls to record a decision."
        />
      </div>

      <div class="feature flip" id="onboarding">
        <div class="copy">
          <h3>Stop chasing people for bios.<Anchor for="onboarding" label="Stop chasing people for bios" /></h3>
          <p>
            Say once what an accepted speaker owes you: headshot, bio, slides, code of conduct, AV
            requirements. Podium tracks every one, for every session and every sponsor, and sends
            the reminders itself.
          </p>
          <p>
            Mark a task <em>blocking</em> and it keeps that session off the public schedule until
            it is done. You find out now, not on the morning of the event.
          </p>
        </div>
        <Shot
          name="onboarding"
          height={1140}
          phoneName="onboarding-phone"
          phoneHeight={975}
          url="app.podiumstack.com/admin/events/…/onboarding"
          alt="The onboarding board: counts of open, blocking, overdue and completed tasks, over a row for each session and each required task with an assignee, a status and a due date."
        />
      </div>

      <div class="feature" id="sponsors">
        <div class="copy">
          <h3>Sponsor sessions are not an afterthought.<Anchor for="sponsors" label="Sponsor sessions are not an afterthought" /></h3>
          <p>
            A sponsor session is paid for, not selected. It still needs content review, the same
            onboarding and the same slot on the schedule. Most CFP tools model the call for
            proposals and leave this half in email.
          </p>
          <p>
            A package is a countable set of entitlements. Two session slots and a logo placement;
            one spent, two still open. The sponsor sees the same count you do.
          </p>
          <p>An unused slot is never quietly lost, and one cannot be spent twice.</p>
        </div>
        <Shot
          name="sponsorships"
          height={840}
          url="app.podiumstack.com/admin/events/…/sponsors"
          alt="A sponsorships table showing three sponsors, their tier, and a progress bar of entitlements used against entitlements bought."
        />
      </div>

      <div class="feature flip" id="schedule">
        <div class="copy">
          <h3>A schedule that cannot quietly break.<Anchor for="schedule" label="A schedule that cannot quietly break" /></h3>
          <p>
            Place sessions into rooms and times and Podium recomputes conflicts on every change: a
            double-booked room, a speaker in two places, a session whose onboarding is not done. It
            will let you save a broken schedule. It will not let you publish one.
          </p>
          <p>
            The public sees an immutable, versioned snapshot. Your site embeds it, a CDN caches it,
            and rolling back is pointing at the previous version.
          </p>
        </div>
        <Shot
          name="schedule"
          height={1170}
          phoneName="schedule-phone"
          phoneHeight={1800}
          url="podiumstack.com/e/your-event/schedule"
          alt="The public schedule: search, track and room filters and an add-to-calendar button, over an itinerary of sessions with their times, rooms and tracks."
        />
      </div>
    </div>
  </section>

  <section class="band" id="speakers">
    <div class="wrap">
      <span class="eyebrow">The other side of it</span>
      <h2>Speakers get one place to look.<Anchor for="speakers" label="Speakers get one place to look" /></h2>
      <p class="sub">
        Where their proposal stands, what they were accepted for, when and where it is, and what
        they still owe you. They keep their own profile, and it is what appears on the public
        schedule, so you stop copy-editing sixty biographies.
      </p>
      <div class="feature">
        <div class="copy">
          <h3>Built for the screen it is read on</h3>
          <p>
            Speakers accept from an emailed link, upload a headshot from the camera roll and tick
            off tasks standing in a queue somewhere. The portal is designed at the narrow width,
            not shrunk to fit it.
          </p>
          <p>
            The public schedule gets the same treatment: an itinerary on a phone, a room-by-time
            grid on a laptop, and both work with scripts blocked on conference wifi.
          </p>
        </div>
        <Shot
          name="portal-phone"
          height={1266}
          phone
          alt="The speaker portal on a phone: an accepted proposal with a confirm-by date, a published session with its room and time, and outstanding tasks with due dates."
          caption="The speaker portal at 390 px — the width it is most often read at."
        />
      </div>
    </div>
  </section>

  <section id="also">
    <div class="wrap">
      <span class="eyebrow">Also in the box</span>
      <h2>And the parts nobody demos.<Anchor for="also" label="And the parts nobody demos" /></h2>
      <p class="sub">
        None of these wins a bake-off. Between them they are most of what makes the last three
        weeks survivable.
      </p>
      <div class="grid-hair three">
        {
          alsoInTheBox.map((item) => (
            <div class="card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))
        }
      </div>
      <p class="nextstep"><a href="/integrations">What it connects to →</a></p>
    </div>
  </section>

  <Cta
    heading="Fifteen minutes with the real thing beats any of this."
    sub="Sign in as the program chair of a conference already mid-flight, and go looking for the screen you did not believe."
    secondaryHref="/compare"
    secondaryLabel="What a switch costs"
  />
</Base>
