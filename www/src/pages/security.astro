---
import Base from "../layouts/Base.astro";
import Anchor from "../components/Anchor.astro";
import Cta from "../components/Cta.astro";
import PageHead from "../components/PageHead.astro";
import { DOMAIN_MODEL_URL, GITHUB_URL, IMPLEMENTATION_URL, STATS } from "../consts";

/*
 * For the person who has to answer "where does our speakers' personal data go"
 * before anyone signs anything, and for the engineer who will be running it.
 *
 * The last section is the one that matters. Every security page on the internet
 * lists what a product does well; the disclosure below is checkable in the
 * repository, which is the only reason to believe the rest of the page.
 *
 * That section carries the August 2026 review — five defects found and fixed —
 * and, after it, the sixth that a plan change closed. The order is deliberate: the
 * history is what makes the confession credible, and a page that quietly
 * acquired five new strengths and mentioned no history would read worse than
 * this does.
 *
 * It also carries what that review did not read, and that block is not
 * decoration. "Six found, six fixed" reads as exhaustive, and the pass was not:
 * the queries that go around the repository layer were counted and never read
 * one by one, and object-level ownership — does this person own the record their
 * permission is pointing at — was never walked at all. The thirty-six is
 * `npm run security:semgrep`, rule `podium-raw-sql-unscoped`, and the CI comment
 * beside it in `.github/workflows/ci.yml` says the same number. Re-measure it
 * before editing it; it moves with the code.
 *
 * Three things this section may never say, each of which would be a stronger
 * sentence and a false impression:
 *
 *   - that a scanner "found nothing". CodeQL and six stock Semgrep packs both
 *     reported zero, and those zeros carry no information — nothing here looks
 *     like what those rules hunt for. The six defects came from a person
 *     reading the code, and the two API-key defects named at the end of the
 *     section came from someone working in that area afterwards.
 *   - that anyone outside this project audited it. "No third-party penetration
 *     test" stays on the crosses list because it is still true.
 *   - that the content policy is finished. Inline *script* is forbidden;
 *     inline styles are still allowed, and there is no CSRF token anywhere —
 *     the cookie policy is the whole of that defence. So the list below says
 *     "where scripts may come from" and stops there.
 *
 * The password-hash disclosure that used to close this section is now a
 * past-tense paragraph, because the defect was fixed while this page was being
 * rewritten. Check `ARGON2_PARAMS` in
 * `packages/domain/src/identity/credentials.ts` before touching that block: if
 * `m` is ever lowered again for a plan, this page says so again, in the present
 * tense, on the same day.
 */

const HANDLING = [
  {
    title: "Redacted unless asked for, everywhere",
    body: "Email addresses, phone numbers, dietary and accessibility notes, travel details, and any answer a form marks personal need their own permission. Without it they are removed, including from a scope that can already read the proposal.",
  },
  {
    title: "Never in a log line",
    body: "Application logs carry identifiers, not values. A person is an id, so an email address cannot leak from a log aggregator, a crash report or a support screenshot.",
  },
  {
    title: "Never in the published schedule",
    body: "The public snapshot carries titles, times, rooms, speaker names and bios. Personal fields are not redacted from it at render time; they never enter it.",
  },
  {
    title: "Two things nobody can unlock",
    body: "Private notes about a person are never visible to that person, and neither is the review data for a proposal they submitted or are credited on. No permission lifts either.",
  },
];

const RIGHTS = [
  {
    title: "Export",
    body: "Any person pulls everything held about them as JSON, plus their uploaded files, from their own portal. Nobody has to ask you, and you do not have to build it.",
  },
  {
    title: "Erasure that reaches the copies",
    body: "Erasure anonymises the record, clears the profile and deletes the files, keeping the proposal and session content they authored. It also deletes their rows from every linked external table, paused ones included. An erasure that stops at your database is not an erasure when half the programme is mirrored into a spreadsheet.",
  },
  {
    title: "Anything that cannot be honoured is said out loud",
    body: "If a provider refuses a delete, the link is left in an error state and surfaced. Nothing reports an erasure that did not fully happen.",
  },
  {
    title: "Retention with a number on it",
    body: "Abandoned drafts are purged after an event closes, two years by default. Audit and event logs are kept for seven years, personal data redacted after two.",
  },
];

const ACCESS = [
  {
    title: "Permissions are recomputed on every request",
    body: "Nothing caches authority. A revoked role takes effect on the next request, not the next sign-in.",
  },
  {
    title: "Blind review is enforced by refusal",
    body: "In a single- or double-blind round, identity is withheld, not hidden with CSS. A reviewer with a declared conflict does not get a warning; the score is refused.",
  },
  {
    title: "API keys are narrow and mortal",
    body: "Scoped to named events, read separated from write, personal data its own additive scope, an expiry, a rate limit, and a secret shown once. A key for your marketing site cannot read a review.",
  },
  {
    title: "Credentials are references, not values",
    body: "An integration stores the name of a secret, never the secret. It is resolved at call time, which keeps a provider token out of the settings screen, the audit log and any export.",
  },
  {
    title: "Everything that matters is audited",
    body: "Who did what, when, from where. Append-only, and surviving an erasure with the identifier alone. Overrides and waivers carry a written reason, so a proposal accepted below quorum has a sentence beside it a year later.",
  },
  {
    title: "One writer for the schedule",
    body: "Two organizers dragging the same slot queue behind one another instead of interleaving. A stale edit anywhere else is refused with the current state.",
  },
];
---

<Base
  title="Security & data"
  description="Where your speakers' personal data lives, what is redacted by default, how export and erasure work, what an August 2026 security review found, what it never read, and what this project still does not have."
>
  <PageHead
    eyebrow="Security & data"
    title="It is your database, in your account, under your policy."
    lede="Podium deploys to a Cloudflare account in your name. Nobody at this project can read your speakers' data, because nobody at this project has it. Below is what the software does with it, and at the bottom, what a review found, what it never read, and what this project still does not have."
  />

  {/* A "what builds it" strip used to hang under that lede. On this page of all
      pages a logo row invites a reading nobody stated — that those vendors are
      in the deployment — and the honest caption for it ("what builds it") is
      not a security claim at all. The lede makes the argument this page needs.
      The strip now appears once, on /fork. */}

  <section id="personal-data">
    <div class="wrap">
      <span class="eyebrow">Personal data</span>
      <h2>Redaction is the default, not a feature.<Anchor for="personal-data" label="Redaction is the default, not a feature" /></h2>
      <p class="sub">
        Adding a field means deciding whether it is personal data before it can ship. That is a rule
        with a check behind it.
      </p>
      <div class="grid-hair two">
        {
          HANDLING.map((h) => (
            <div class="card">
              <h3>{h.title}</h3>
              <p>{h.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band" id="subject-rights">
    <div class="wrap">
      <span class="eyebrow">Subject rights</span>
      <h2>Export and erasure are features, not a support process.<Anchor for="subject-rights" label="Export and erasure are features, not a support process" /></h2>
      <p class="sub">
        A speaker asking to be removed should not cost you an afternoon and a query you write by
        hand.
      </p>
      <div class="grid-hair two">
        {
          RIGHTS.map((r) => (
            <div class="card">
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="access">
    <div class="wrap">
      <span class="eyebrow">Access control</span>
      <h2>Six properties the rest of it rests on.<Anchor for="access" label="Six properties the rest of it rests on" /></h2>
      <div class="grid-hair three">
        {
          ACCESS.map((a) => (
            <div class="card">
              <h3>{a.title}</h3>
              <p>{a.body}</p>
            </div>
          ))
        }
      </div>
      <p class="nextstep"><a href={DOMAIN_MODEL_URL}>The authorization matrix, written out in full →</a></p>
    </div>
  </section>

  <section id="disclosed">
    <div class="wrap">
      <span class="eyebrow">Disclosed</span>
      <h2>What a review found, and where it stopped.<Anchor for="disclosed" label="What a review found, and where it stopped" /></h2>
      <p class="sub">
        Nobody had read this product as a whole for security until August 2026. The review was
        internal: our own people on our own code, not an outside audit. It found six defects, all
        fixed, the five below each with the test that would have caught it. It was also a first
        pass. Two areas were counted and never read.
      </p>
      <ul class="ticks">
        <li>
          Bytes somebody uploaded are never served back as something a browser will run — screened
          on the way in and again on the way out, so files stored before the fix are covered too.
          A speaker's headshot was the way in.
        </li>
        <li>
          Every response declares where scripts may come from, and inline script is not one of the
          answers. Nothing may frame the app or guess at a file's type. The schedule embed is the
          one deliberate exception, because being put in someone else's page is its job.
        </li>
        <li>The session cookie travels only over https and is unreadable to scripts.</li>
        <li>A sign-in link can only send you onward to a page inside your own deployment.</li>
        <li>
          Password guessing is capped — ten failures against one address, fifty from one source, in
          a rolling fifteen minutes — and refused before the password is checked at all, on every
          screen that checks one.
        </li>
      </ul>
      <p>A sixth finding took a plan change rather than a line of code, and it is now closed:</p>
      {/* This block said "deliberately below the recommended work factor" until
          the hour this page was rewritten. The stopgap it described — m=256 KiB,
          t=1, forced by the free plan's ten-millisecond CPU ceiling — was undone
          in `packages/domain/src/identity/credentials.ts`, which now reads
          `ARGON2_PARAMS = { t: 3, m: 12288, p: 1 }`. Leaving the confession up
          after the defect is fixed is its own kind of inaccurate. */}
      <div class="notice">
        <p>
          <strong>Passwords were hashed below the recommended work factor</strong> while the
          deployment sat on Cloudflare's free plan, which allows ten milliseconds of processing per
          request. That was roughly two orders of magnitude cheaper to attack offline than it
          should have been, and it was disclosed here for as long as it was true.
        </p>
        <p>
          The plan changed and the parameters went back: 12 MiB of memory, three passes, on
          OWASP's own list for this algorithm. A hash costs about 108 ms. An old hash is carried up
          the next time its owner signs in, so nobody was reset and nothing was migrated.
        </p>
        <p>
          Two things still hold the line in front of it. Guessing at the sign-in form is capped and
          refused before the password is checked at all, and password sign-in is off by default in
          production, with invitations the intended route in.
        </p>
      </div>
      {/* The point of this block: "six found, six fixed" is a true sentence that
          leaves a false impression, and a buyer who later finds the gaps
          themselves stops believing the four sections above it. Both areas are
          real and both are named in `.claude/skills/security-audit/SKILL.md`
          under "Work the lanes". Update the count, or delete the paragraph, if
          `npm run security:semgrep` stops reporting thirty-six. */}
      <div class="prose">
        <h3>Two areas the review never read</h3>
        <p>
          Scoping to your organization happens once, in the layer every query is meant to go
          through. Thirty-six go around it and answer for their own scoping. They were counted.
          Nobody read them one at a time, and one missed scope there is one conference reading
          another's data.
        </p>
        <p>
          Holding a permission is not the same as owning the record you point it at. A handler that
          checks "may this person edit proposals" and then trusts the id in the URL passes review.
          Nobody has walked the routes where permission comes from a relationship: a speaker on
          their own session, a sponsor contact on their own account. No tool finds this one.
        </p>
        <p>
          Separate work on API keys found two more authorization defects after that pass closed. A
          read-only key was refused every read it was granted. A key scoped to onboarding tasks
          could mint a second key that read personal data. Both are fixed.
        </p>
      </div>
      <div class="two-col">
        <div>
          <h3>What this project does not have</h3>
          <ul class="crosses">
            <li>No SOC 2, ISO 27001 or any audited compliance programme</li>
            <li>No third-party penetration test</li>
            <li>No security team, and no disclosure SLA — report it in the issue tracker</li>
            <li>No hosted service, so no vendor to answer your questionnaire</li>
          </ul>
        </div>
        <div>
          <h3>What you have instead</h3>
          <ul class="ticks">
            <li>The whole source, and the specification it was built against</li>
            <li>Every rule written down before the code, and checked against it in CI</li>
            {/* Not "routes inventoried with the guard in front of them". That
                is a repository concept and a number this project keeps for
                itself; what a buyer feels is that nobody can add a screen and
                forget the permission check on it. The landing page says the
                same count the same way. */}
            <li>
              All {STATS.routes} URLs in the app checked on every build; a new one with no permission
              check fails rather than waiting for the next review
            </li>
            <li>Your own account, your own region choices, your own backups</li>
            <li>The ability to have your own people review it before you deploy it</li>
          </ul>
        </div>
      </div>
      <p class="nextstep"><a href={IMPLEMENTATION_URL}>The implementation notes, and the hashing decision in full →</a></p>
    </div>
  </section>

  <Cta
    heading="Read it before you run it."
    sub="Every rule on this page is in the model, and every enforcement of it is in the code, in the same repository."
    secondaryHref={GITHUB_URL}
    secondaryLabel="Get the source"
  />
</Base>
