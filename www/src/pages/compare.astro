---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import PageHead from "../components/PageHead.astro";
import Pillars from "../components/Pillars.astro";
import {
  AUDIENCES,
  CHECKED,
  NOT_FOR_YOU,
  SESSIONBOARD_URL,
  SESSIONIZE_URL,
  STRUCTURAL,
  WHERE_THEY_WIN,
} from "../data/comparison";

/*
 * For the buyer with three tabs open, and for the colleague who will ask "why
 * not just use Sessionize?" in the next meeting.
 *
 * The rule this page is written under: nothing here characterises a competitor's
 * product as bad, and every row they win is on the page. A comparison that a
 * reader can catch being unfair costs more than the deal it was written to win.
 * See `src/data/comparison.ts` for why there is no feature matrix.
 */
---

<Base
  title="Compare"
  description="Podium against Sessionize and Sessionboard: what each is built for, where the incumbents are stronger, and when you should not pick Podium at all."
>
  <PageHead
    eyebrow="Compare"
    title="Three good answers to different questions."
    lede={`Sessionize and Sessionboard are both reasonable buys, and for some conferences they are the right one. Here is the shape of the choice, including where they win. Checked against their own pages in ${CHECKED}.`}
  />

  <section>
    <div class="wrap">
      <span class="eyebrow">Who each is for</span>
      <h2>Start here and you may not need the rest.</h2>
      <div class="cards">
        {
          AUDIENCES.map((a) => (
            <div class="card reveal">
              <h3>{a.name}</h3>
              <p><strong>{a.built_for}</strong></p>
              <p>{a.body}</p>
              {a.href && (
                <p class="jump">
                  <a href={a.href} rel="nofollow noopener">Their pricing page →</a>
                </p>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <span class="eyebrow">The structural difference</span>
      <h2>Everything below is true regardless of what ships next.</h2>
      <p class="sub">
        There is no feature matrix here. It would mean asserting from the outside what two
        proprietary products do, and it would be stale the day either ships a release. These rows
        are licensing, hosting and packaging.
      </p>
      <div class="table-wrap">
        <table class="matrix">
          <thead>
            <tr>
              <th scope="col"></th>
              <th scope="col" class="mine">Podium</th>
              <th scope="col">Sessionize</th>
              <th scope="col">Sessionboard</th>
            </tr>
          </thead>
          <tbody>
            {
              STRUCTURAL.map((r) => (
                <tr>
                  <th scope="row">{r.row}</th>
                  <td class="mine">{r.podium}</td>
                  <td>{r.sessionize}</td>
                  <td>{r.sessionboard}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="aside">
        Pricing and packaging change. Confirm both on their own pages before you decide:
        <a href={SESSIONIZE_URL} rel="nofollow noopener">Sessionize</a> and
        <a href={SESSIONBOARD_URL} rel="nofollow noopener">Sessionboard</a>. Do not take a
        competitor's word for it, ours included.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Where they win</span>
      <h2>Five things the incumbents do better, today.</h2>
      <p class="sub">None of these is fixable by writing a better sentence about it.</p>
      <div class="cards">
        {
          WHERE_THEY_WIN.map((w) => (
            <div class="card reveal">
              <h3>{w.title}</h3>
              <p>{w.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* This band used to carry five hand-written differences that were the five
      pillars in different words. Two wordings of one argument is how a reader
      comes away unable to repeat either, so it is now the pillars themselves —
      the same sentences the home page uses, on the page where the reader is
      deciding between three products. The two claims that were only ever here,
      because they are only interesting next to a competitor, are the cards
      below it. */}
  <Pillars
    eyebrow="Where Podium wins"
    heading="Five differences worth switching for."
    sub="Not a feature list. These are the ones that hold whatever either product ships next."
  >
    <div class="cards two" style="margin-top: 2.5rem">
      <div class="card reveal">
        <h3>Sponsor sessions are modelled, not bolted on</h3>
        <p>
          A package is a countable set of entitlements — two session slots, a logo placement — and
          a sponsor session consumes one. Used against bought, on the same screen as the deal. Most
          tools in this category leave the paid half in email.
        </p>
      </div>
      <div class="card reveal">
        <h3>Review integrity is enforced, not requested</h3>
        <p>
          A reviewer who submitted, is credited on, or has declared a conflict with a proposal
          cannot score it. The write is refused, with no convention to rely on and no flag for
          someone to catch afterwards.
        </p>
      </div>
    </div>
    <p class="nextstep"><a href="/pricing">The actual bill, itemised →</a></p>
  </Pillars>

  <section>
    <div class="wrap">
      <span class="eyebrow">Be honest with yourself</span>
      <h2>Do not pick Podium if any of these is true.</h2>
      <p class="sub">
        Better to find this out here than in February. If two or more land, buy something hosted
        and enjoy your conference.
      </p>
      <ul class="crosses">{NOT_FOR_YOU.map((n) => <li>{n}</li>)}</ul>
    </div>
  </section>

  <Cta
    heading="Still here? Go and use it."
    sub="Fifteen minutes in a conference already mid-flight will tell you more than this page did."
    secondaryHref="/features"
    secondaryLabel="See the screens first"
  />
</Base>
