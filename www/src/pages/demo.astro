---
import Base from "../layouts/Base.astro";
import Anchor from "../components/Anchor.astro";
import PageHead from "../components/PageHead.astro";
import Shot from "../components/Shot.astro";
import { APP_URL, DEMO_PERSONAS, GITHUB_URL, SIGN_IN_URL } from "../consts";

/*
 * The page the rest of the site points at, and the one that has to work.
 *
 * For a while it led with `npm run dev` rather than the hosted instance, because
 * the hosted instance was not carrying the seed: `POST /login` came back "That
 * email and password did not match" and `/e/devflow-conf-2027` 404d. A call to
 * action that dead-ends on a login form is the single worst thing a page like
 * this can do, so the page led with the route that was checkable instead.
 *
 * app.podiumstack.com now serves the seeded DevFlow Conf 2027 org and all three
 * sign-ins below reach their surfaces on it, so the hosted route leads again —
 * a reader who wants to see the product should not have to install anything.
 * The local route keeps its place directly underneath, because it is the one
 * that stays true when the hosted instance is chewed up or down.
 *
 * Two things this page must not claim, both of which it used to:
 *   - that the seed installs no email provider. It installs Resend, active. The
 *     difference is the key: locally there is none unless you put one in
 *     `.dev.vars`, so a message is composed, recorded and fails at the provider.
 *     On the hosted instance the key is real and mail genuinely leaves — to
 *     `@devflowconf.example`, a reserved domain nobody receives.
 *   - that the hosted database is reset. Nothing resets it. It is shared and
 *     writable by anyone holding the sign-ins below, which is everyone.
 *
 * Ordered by who is most likely to be reading: the chair first, then the two
 * roles they will want to show a colleague.
 */

const TOUR = [
  {
    title: "Open the agenda and break it",
    body: "Drag a session onto a room that is already busy. The conflict appears beside the grid as you drop it, and the publish button stays shut until it is resolved or acknowledged with a reason.",
  },
  {
    title: "Try to review your own proposal",
    body: "As the reviewer, find a proposal you are credited on. There is no score box to fill in.",
  },
  {
    title: "Spend a sponsor's second session slot",
    body: "On the sponsors screen, watch the used-against-bought count move. Then try to spend one more than the package holds.",
  },
  {
    title: "Publish the schedule, then roll it back",
    body: "Publishing writes an immutable snapshot; rolling back points at the previous one. Neither touches the live programme tables.",
  },
  {
    title: "Look at the outbox",
    body: "Every message sent or attempted, with its template, recipient and status — the rendered body is stored before the provider is ever called, so you can rehearse an announcement to four hundred speakers and read exactly what each of them would get.",
  },
];
---

<Base
  title="Try it"
  description="Sign in to a conference already mid-flight at app.podiumstack.com, or run the same one on your laptop in one command — proposals in every state, a review round with real scores, sponsors part-way through their entitlements and an agenda with genuine conflicts. Sign-ins on the page."
>
  <PageHead
    eyebrow="Try it"
    title="Sign in to a conference that is halfway through its year."
    lede="DevFlow Conf 2027 is running at app.podiumstack.com with the sign-ins printed on this page. Proposals in every state, a review round with real scores, sponsors part-way through their entitlements, an agenda with conflicts. No form, no card, no trial clock."
  />

  <section id="hosted">
    <div class="wrap">
      <span class="eyebrow">Thirty seconds</span>
      <h2>Sign in and start clicking.<Anchor for="hosted" label="Sign in and start clicking" /></h2>
      <p class="sub">
        The conference running at app.podiumstack.com is the one the seed in this repository
        builds, which is the one the screenshots on this site were taken from.
      </p>
      <div class="actions">
        <a class="btn primary" href={SIGN_IN_URL}>Open the hosted demo →</a>
      </div>
      <p>
        Pick a role from the table below. Nothing is read-only: you are signing in as a real
        organizer of a real event, and everything you change stays changed.
      </p>
    </div>
  </section>

  <section id="local">
    <div class="wrap">
      <span class="eyebrow">Four minutes</span>
      <h2>Or run the whole thing on your laptop.<Anchor for="local" label="Or run the whole thing on your laptop" /></h2>
      <p class="sub">
        Same seed, same conference, nobody else in it. This is also the version to use if the
        hosted one is busy or someone has already rearranged the agenda.
      </p>
      <pre class="term"><code>git clone https://github.com/sameersegal/Podium
cd Podium
npm install
npm run dev</code></pre>
      <p>
        Then open <code>http://localhost:8787/login</code> with the same sign-ins. No Cloudflare
        account is involved: the database, the queues and the object store all run on your machine.
      </p>
    </div>
  </section>

  <section class="band" id="signins">
    <div class="wrap">
      <span class="eyebrow">Sign-ins</span>
      <h2>Three roles. Same conference, three different products.<Anchor for="signins" label="Three roles. Same conference, three different products" /></h2>
      <p class="sub">
        What each person may see is worked out per request. Signing in as the speaker is the only
        honest way to find out what a speaker sees.
      </p>
      <div class="table-wrap">
        <table class="matrix creds stack">
          <thead>
            <tr>
              <th scope="col">Role</th>
              <th scope="col">Email</th>
              <th scope="col">Password</th>
              <th scope="col">What you land in</th>
            </tr>
          </thead>
          <tbody>
            {
              DEMO_PERSONAS.map((p) => (
                <tr>
                  <th scope="row">{p.role}</th>
                  <td class="cred" data-label="Email">{p.email}</td>
                  <td class="cred" data-label="Password">{p.password}</td>
                  <td data-label="What you land in">{p.sees}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="notice">
        <p>
          <strong>These work on <a href={APP_URL}>app.podiumstack.com</a> and on your own copy,
          and they are public on purpose.</strong> Which means the hosted one is shared: everybody
          reading this page has the organizer's password, nothing resets it on a schedule, and
          whatever state you find it in is what the last visitor left. If you want a conference
          that is only yours, that is the four-minute route above.
        </p>
      </div>
    </div>
  </section>

  <section id="tour">
    <div class="wrap">
      <span class="eyebrow">Fifteen minutes</span>
      <h2>Five things worth trying, in the order they prove something.<Anchor for="tour" label="Five things worth trying, in the order they prove something" /></h2>
      <p class="sub">Every one is a claim made elsewhere on this site. Go and check them.</p>
      <ol class="steps">
        {
          TOUR.map((t) => (
            <li>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
            </li>
          ))
        }
      </ol>

      {/* The screen two of those five steps happen on, so the reader knows what
          they are looking for before they sign in. Directly after the list, not
          inside a spacer div: `.steps + .shot-fig` is a rule in the stylesheet
          and a wrapper hides the adjacency from it. */}
      <Shot
        name="agenda"
        height={1170}
        phoneName="agenda-phone"
        phoneHeight={1266}
        url="localhost:8787/admin/events/…/agenda"
        alt="The agenda screen: a panel naming two conflicts that block publication, above a room-by-time grid with sessions placed across Main Stage, Room 2A, Room 2B and the Workshop Lab."
        caption="The agenda in the seeded conference, with the two conflicts already waiting for you."
      />
    </div>
  </section>

  <section id="mail">
    <div class="wrap">
      <div class="feature">
        <div class="copy">
          <span class="eyebrow">While it is running</span>
          <h3>Give it a key and watch mail actually leave.<Anchor for="mail" label="Give it a key and watch mail actually leave" /></h3>
          <p>
            The seed installs Resend already, active and set as the default — what it does not ship
            is a key, because credentials never live in a seed. So locally every acceptance and
            reminder is rendered, stored and then fails at the provider, which you can read in the
            outbox. Put your own <code>RESEND_API_KEY</code> in <code>.dev.vars</code> and the same
            messages go out for real. It costs nothing and it is the only honest way to try the
            integrations.
          </p>
          <p class="jump"><a href={GITHUB_URL}>The repository, and the rest of the setup →</a></p>
        </div>
        <Shot
          name="dashboard"
          height={660}
          url="localhost:8787/admin/events/…"
          alt="The event dashboard on a local install, showing counts of days, tracks, formats, rooms and calls for proposals."
        />
      </div>
    </div>
  </section>

  <section class="band cta" id="feedback">
    <div class="wrap">
      <h2>Found something that does not hold up?<Anchor for="feedback" label="Found something that does not hold up?" /></h2>
      <p class="sub">
        Every claim on this site should be checkable in that seed. If one is not, that is a bug in
        the site or the product, and both live in the same repository.
      </p>
      <div class="actions">
        <a class="btn primary" href={`${GITHUB_URL}/issues/new`}>Tell us what broke</a>
        <a class="btn secondary" href="/features">Back to the tour</a>
      </div>
    </div>
  </section>
</Base>
