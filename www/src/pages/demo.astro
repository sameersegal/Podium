---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import Shot from "../components/Shot.astro";
import { APP_URL, DEMO_PERSONAS, GITHUB_URL } from "../consts";

/*
 * The page the rest of the site points at, and the one that has to work.
 *
 * It used to lead with the hosted instance and print these sign-ins as its
 * credentials. On the day this was rewritten they did not work there:
 * `POST /login` as sbek-organizer@example.com returns "That email and password
 * did not match", and `/e/devflow-conf-2027` 404s, so the deployment is not
 * carrying this seed. A call to action that dead-ends on a login form is the
 * single worst thing a page like this can do, so the page now leads with the
 * route that is checkable from the repository — `npm run dev`, and the seed
 * personas in `scripts/seed.mjs` — and says plainly what the hosted instance
 * currently is. Put the hosted route back at the top when signing into it
 * works; the sign-ins are the same ones.
 *
 * Ordered by who is most likely to be reading: the chair first, then the two
 * roles they will want to show a colleague.
 */

const TOUR = [
  {
    title: "Open the agenda and break it",
    body: "Drag a session onto a room that is already busy. The conflict appears beside the grid as you drop it, and the publish button stays shut until it is resolved or acknowledged with a reason.",
  },
  {
    title: "Try to review your own proposal",
    body: "As the reviewer, find a proposal you are credited on. There is no score box to fill in.",
  },
  {
    title: "Spend a sponsor's second session slot",
    body: "On the sponsors screen, watch the used-against-bought count move. Then try to spend one more than the package holds.",
  },
  {
    title: "Publish the schedule, then roll it back",
    body: "Publishing writes an immutable snapshot; rolling back points at the previous one. Neither touches the live programme tables.",
  },
  {
    title: "Look at the outbox",
    body: "Every message sent or attempted, with its template, recipient and status. The seed installs no email provider, so every message is composed, recorded and stopped — which is how you rehearse an announcement to four hundred speakers.",
  },
];
---

<Base
  title="Try it"
  description="Run a conference already mid-flight on your own laptop in one command — proposals in every state, a review round with real scores, sponsors part-way through their entitlements and an agenda with genuine conflicts. Sign-ins on the page."
>
  <PageHead
    eyebrow="Try it"
    title="Run a conference that is halfway through its year."
    lede="One command resets a local database, seeds DevFlow Conf 2027 and serves it on port 8787. Proposals in every state, a review round with real scores, sponsors part-way through their entitlements, an agenda with conflicts. No form, no card, no trial clock."
  />

  <section>
    <div class="wrap">
      <span class="eyebrow">Four minutes</span>
      <h2>Clone it and go.</h2>
      <p class="sub">
        The seed ships with the source, so the conference you are looking at is the one the
        screenshots on this site were taken from.
      </p>
      <pre class="term"><code>git clone https://github.com/sameersegal/Podium
cd Podium
npm install
npm run dev</code></pre>
      <p>
        Then open <code>http://localhost:8787/login</code> and sign in as whoever you want to be.
        No Cloudflare account is involved: the database, the queues and the object store all run
        on your machine.
      </p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <span class="eyebrow">Sign-ins</span>
      <h2>Three roles. Same conference, three different products.</h2>
      <p class="sub">
        What each person may see is worked out per request. Signing in as the speaker is the only
        honest way to find out what a speaker sees.
      </p>
      <div class="table-wrap">
        <table class="matrix creds stack">
          <thead>
            <tr>
              <th scope="col">Role</th>
              <th scope="col">Email</th>
              <th scope="col">Password</th>
              <th scope="col">What you land in</th>
            </tr>
          </thead>
          <tbody>
            {
              DEMO_PERSONAS.map((p) => (
                <tr>
                  <th scope="row">{p.role}</th>
                  <td class="cred" data-label="Email">{p.email}</td>
                  <td class="cred" data-label="Password">{p.password}</td>
                  <td data-label="What you land in">{p.sees}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="notice" style="margin-top: 1.75rem">
        <p>
          <strong>There is a hosted instance at <a href={APP_URL}>app.podiumstack.com</a>, and it
          is not carrying this seed today.</strong> These sign-ins are the local ones. When it is
          seeded again they are the same three, on the same conference. Sending you to a login you
          cannot pass would be the one thing this site is not for.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Fifteen minutes</span>
      <h2>Five things worth trying, in the order they prove something.</h2>
      <p class="sub">Every one is a claim made elsewhere on this site. Go and check them.</p>
      <ol class="steps">
        {
          TOUR.map((t) => (
            <li class="reveal">
              <h3>{t.title}</h3>
              <p>{t.body}</p>
            </li>
          ))
        }
      </ol>

      {/* The screen two of those five steps happen on, so the reader knows what
          they are looking for before they sign in. */}
      <div class="reveal" style="margin-top: 2.5rem">
        <Shot
          name="agenda"
          height={1170}
          phoneName="agenda-phone"
          phoneHeight={1266}
          url="localhost:8787/admin/events/…/agenda"
          alt="The agenda screen: a panel naming two conflicts that block publication, above a room-by-time grid with sessions placed across Main Stage, Room 2A, Room 2B and the Workshop Lab."
          caption="The agenda in the seeded conference, with the two conflicts already waiting for you."
        />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="feature reveal">
        <div class="copy">
          <span class="eyebrow">While it is running</span>
          <h3>Point it at your own provider and watch mail leave.</h3>
          <p>
            The seed installs no email provider, so every acceptance and reminder is composed and
            recorded and never sent. Install Resend with your own key and the same messages go out
            for real. It is the only way to try the integrations, and it costs nothing.
          </p>
          <p class="jump"><a href={GITHUB_URL}>The repository, and the rest of the setup →</a></p>
        </div>
        <Shot
          name="dashboard"
          height={660}
          url="localhost:8787/admin/events/…"
          alt="The event dashboard on a local install, showing counts of days, tracks, formats, rooms and calls for proposals."
        />
      </div>
    </div>
  </section>

  <section class="band-dark cta">
    <div class="wrap">
      <h2>Found something that does not hold up?</h2>
      <p class="sub">
        Every claim on this site should be checkable in that seed. If one is not, that is a bug in
        the site or the product, and both live in the same repository.
      </p>
      <div class="actions">
        <a class="btn primary" href={`${GITHUB_URL}/issues/new`}>Tell us what broke</a>
        <a class="btn secondary" href="/features">Back to the tour</a>
      </div>
    </div>
  </section>
</Base>
