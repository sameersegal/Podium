---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import PageHead from "../components/PageHead.astro";
import { GITHUB_URL, LICENSE_URL } from "../consts";

/*
 * For whoever holds the budget, and for the chair who has to explain to them
 * why "free" is not a trap.
 *
 * The temptation on this page is to write "free" in 96 point and stop. That
 * loses the sale in the second meeting, when someone asks what the hosting
 * costs and there is no answer. So: what is free, what is metered, what is not
 * money at all, and a refusal to invent a monthly total we have not measured.
 */

const CLOUDFLARE_PRICING = "https://developers.cloudflare.com/workers/platform/pricing/";

/** What the bill is actually made of. No totals — see the note on the page. */
const LINE_ITEMS = [
  {
    item: "The software",
    cost: "£0 / $0 / €0",
    note: "Apache-2.0. No licence, no seat, no per-speaker charge, no per-event activation, and no edition of it that costs more.",
  },
  {
    item: "Cloudflare Workers Paid",
    cost: "From $5 / month",
    note: "The one fixed line. It carries the application, the database, the queues and the scheduled jobs. Published on Cloudflare's own pricing page and correct in August 2026 — check it, it is not our price to promise.",
  },
  {
    item: "Storage and messages",
    cost: "Metered, small",
    note: "Headshots, slides and recordings in your own bucket; database reads and writes; queue messages. A conference is a small workload next to the included allowances, but your event is not our event — put your numbers into Cloudflare's calculator rather than trusting a figure from us.",
  },
  {
    item: "An email provider",
    cost: "Often free at this volume",
    note: "Resend and SendGrid both have a free tier that a single conference's mail usually fits inside. Install nothing and mail is composed and recorded but never sent, which is a legitimate way to run a rehearsal.",
  },
  {
    item: "A domain",
    cost: "You already have one",
    note: "It runs on a subdomain of the conference site you are already paying for.",
  },
];

const NOT_MONEY = [
  {
    title: "Somebody has to deploy it once",
    body: "Clone, set two secrets, run one command. It is an afternoon for an engineer who has met Cloudflare before, and a real blocker if there is no such person on the team. This is the honest cost of the whole model, and it is not measured in dollars.",
  },
  {
    title: "Somebody has to upgrade it",
    body: "Pulling a release and redeploying is a five-minute job, but it is a job, and nobody will do it for you. Migrations are additive and checked in; the tests run against a database built from scratch and against one holding representative rows.",
  },
  {
    title: "Support is a discussion board",
    body: "Issues and discussions, answered by the people who wrote it. There is no ticket queue, no response-time commitment and nobody contractually on the hook the week of your event. If you need that, buy something hosted — we mean it.",
  },
];

const FAQ = [
  {
    q: "What is the catch? Where does the money come from?",
    a: "There is none, because there is no company. Podium is an Apache-2.0 project, not a free tier with a sales team attached to it. Nothing is gated, there is no enterprise edition, and no feature is held back to make one.",
  },
  {
    q: "Will the price change once we depend on it?",
    a: "There is no price to change. The licence is irrevocable for the version you have, so the worst case for you is that development stops and you keep running the copy you deployed — with the source, the tests and the specification in your own repository.",
  },
  {
    q: "Do we pay more as the CFP grows?",
    a: "Not to us, and barely to Cloudflare. The metered lines scale with traffic and storage, not with speakers, proposals, reviewers, events or team members. A CFP that gets four hundred submissions instead of forty does not move the bill.",
  },
  {
    q: "Can we get our data out?",
    a: "CSV export of everything, and a REST API with your own keys. There is no export ticket to raise, no format only we can read, and the database is in your account — you can also just query it.",
  },
  {
    q: "Can we pay someone to run it for us?",
    a: "Nobody offers that today. It is an ordinary Cloudflare deployment, so an agency or a contractor who works with Workers can operate it, and nothing in the project stands in the way of a hosted offering existing.",
  },
];
---

<Base
  title="Pricing"
  description="Podium is free and Apache-2.0. The only bill is your own Cloudflare account — here is what it is made of, and what the model costs you in things that are not money."
>
  <PageHead
    eyebrow="Pricing"
    title="The software is free. The hosting is yours. That is the whole model."
    lede="No licence, no seats, no per-speaker charge, no sales call and no quote. What follows is what you will actually pay and, more usefully, what this model costs you in things that are not money."
  >
    <div class="actions">
      <a class="btn primary" href="/demo">Try the demo</a>
      <a class="btn secondary" href={LICENSE_URL}>Read the licence</a>
    </div>
  </PageHead>

  <section>
    <div class="wrap">
      <span class="eyebrow">The bill, itemised</span>
      <h2>Five lines, one of which is fixed.</h2>
      <div class="table-wrap">
        <table class="matrix">
          <thead>
            <tr>
              <th scope="col">Line</th>
              <th scope="col">Cost</th>
              <th scope="col">What it is</th>
            </tr>
          </thead>
          <tbody>
            {
              LINE_ITEMS.map((l) => (
                <tr>
                  <th scope="row">{l.item}</th>
                  <td class="mine">{l.cost}</td>
                  <td>{l.note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="notice" style="margin-top: 1.5rem">
        <p>
          <strong>We are not going to invent a monthly total for you.</strong> Every "typical bill"
          figure on a page like this is a guess dressed up as a measurement, and you would find out
          it was wrong on your own invoice. The fixed line is published; the metered lines depend on
          your traffic. <a href={CLOUDFLARE_PRICING} rel="nofollow noopener">Cloudflare's pricing</a>
          is the source, and it is the only one that binds.
        </p>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <span class="eyebrow">The other half of the price</span>
      <h2>What it costs you that is not money.</h2>
      <p class="sub">
        This is where an open-source tool is genuinely more expensive than a hosted one, and
        pretending otherwise would waste your afternoon and ours.
      </p>
      <div class="cards">
        {
          NOT_MONEY.map((n) => (
            <div class="card reveal">
              <h3>{n.title}</h3>
              <p>{n.body}</p>
            </div>
          ))
        }
      </div>
      <p class="nextstep"><a href="/compare">If that is a dealbreaker, here is what to buy instead →</a></p>
    </div>
  </section>

  <section class="band-dark">
    <div class="wrap">
      <span class="eyebrow">What you never pay for</span>
      <h2>Things that are line items elsewhere.</h2>
      <div class="two-col">
        <ul class="ticks">
          <li>Extra speakers, proposals, reviewers or committee members</li>
          <li>A second event, or last year's archived one</li>
          <li>Additional team seats or admin users</li>
          <li>The API, the webhooks, or a higher rate limit on either</li>
        </ul>
        <ul class="ticks">
          <li>Getting your own data back out</li>
          <li>Single sign-on, when the adapter exists</li>
          <li>A feature held back for a higher tier — there are no tiers</li>
          <li>An activation code per conference occurrence</li>
        </ul>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Questions people actually ask</span>
      <h2>The ones that come up in the second meeting.</h2>
      <div class="faq">
        {
          FAQ.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div class="body">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
      <p class="nextstep"><a href="/security">Where your speakers' data lives →</a></p>
    </div>
  </section>

  <Cta
    heading="The cheapest way to find out is to go and use it."
    sub="No card, no form, no trial clock. Sign in as the program chair of a conference that is already halfway through its year."
    secondaryHref={GITHUB_URL}
    secondaryLabel="Read the source first"
  />
</Base>
