---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import PageHead from "../components/PageHead.astro";
import { GITHUB_URL, LICENSE_URL } from "../consts";

/*
 * For whoever holds the budget, and for the chair who has to explain to them
 * why "free" is not a trap.
 *
 * The temptation on this page is to write "free" in 96 point and stop. That
 * loses the sale in the second meeting, when someone asks what the hosting
 * costs and there is no answer. So: what is free, what is metered, what is not
 * money at all, and a refusal to invent a monthly total we have not measured.
 *
 * What changed when this page was rewritten for the reader who has already
 * decided to leave: deploying it is no longer filed under costs. This reader
 * came *for* the self-hosting; a page that apologises for it is written for
 * somebody else. So the sequence is on the page as a recipe — the resources are
 * the bindings in `wrangler.jsonc`, the two commands are `deploy:migrate` and
 * `deploy` in the root `package.json`, and the one Workers Secret is the block
 * comment in `wrangler.jsonc`. What stays under costs is the part that is
 * genuinely a cost and does not go away: upgrades are yours, and support is an
 * issue tracker.
 */

const CLOUDFLARE_PRICING = "https://developers.cloudflare.com/workers/platform/pricing/";

/** What the bill is actually made of. No totals — see the note on the page. */
const LINE_ITEMS = [
  {
    item: "The software",
    cost: "£0 / $0 / €0",
    note: "MIT. No licence, no seat, no per-speaker charge, no per-event activation, and no edition that costs more.",
  },
  {
    item: "Cloudflare Workers Paid",
    cost: "From $5 / month",
    note: "The one fixed line. It carries the application, the database, the queues and the scheduled jobs. Published on Cloudflare's own pricing page and correct in August 2026. Check it; it is not our price to promise.",
  },
  {
    item: "Storage and messages",
    cost: "Metered, small",
    note: "Headshots and slides in your own bucket, database reads and writes, queue messages. A conference is a small workload next to the included allowances, but your event is not our event. Put your numbers into Cloudflare's calculator.",
  },
  {
    item: "An email provider",
    cost: "Often free at this volume",
    note: "Resend and SendGrid both have a free tier that one conference's mail usually fits inside. Install nothing and mail is composed and recorded but never sent, which is a legitimate way to rehearse.",
  },
  {
    item: "A domain",
    cost: "You already have one",
    note: "It runs on a subdomain of the conference site you already pay for.",
  },
];

const NOT_MONEY = [
  {
    title: "Upgrades are yours to take",
    body: "Pulling a release and redeploying is a five-minute job, but it is a job, and nobody will do it for you. Migrations are append-only and checked in, so the schema moves forward with the code.",
  },
  {
    title: "Support is an issue tracker",
    body: "Open an issue and the people who wrote it answer it. No ticket queue, no response-time commitment, nobody contractually on the hook the week of your event. If you need that, buy something hosted.",
  },
  {
    title: "Nobody is watching it but you",
    body: "Cloudflare's dashboard shows you the errors and the invoice. There is no status page to check and no vendor to email when something is slow at nine on a Monday.",
  },
];

const FAQ = [
  {
    q: "What is the catch? Where does the money come from?",
    a: "There is none, because there is no company. Nothing is gated, there is no enterprise edition, and no feature is held back to make one.",
  },
  {
    q: "Will the price change once we depend on it?",
    a: "There is no price to change. The licence is irrevocable for the version you have, so the worst case is that development stops and you keep running the copy you deployed.",
  },
  {
    q: "Do we pay more as the CFP grows?",
    a: "Not to us, and barely to Cloudflare. The metered lines scale with traffic and storage, not with speakers, proposals, reviewers, events or team members. Four hundred submissions instead of forty does not move the bill.",
  },
  {
    q: "Can we get our data out?",
    a: "CSV export of everything, and a REST API with your own keys. No export ticket to raise, no format only we can read, and the database is in your account.",
  },
  {
    q: "Can we pay someone to run it for us?",
    a: "Nobody offers that today. It is an ordinary Cloudflare deployment, so an agency or contractor who works with Workers can operate it.",
  },
];
---

<Base
  title="Pricing"
  description="Podium is free and MIT-licensed. The only bill is your own Cloudflare account — here is what it is made of, and what the model costs you in things that are not money."
>
  <PageHead
    eyebrow="Pricing"
    title="The software is free. The hosting is yours. That is the whole model."
    lede="No licence, no seats, no per-speaker charge, no sales call and no quote. Below is what you will actually pay, and what this model costs you in things that are not money."
  >
    <div class="actions">
      <a class="btn primary" href="/demo">Run the demo</a>
      <a class="btn secondary" href={LICENSE_URL}>Read the licence</a>
    </div>
  </PageHead>

  <section>
    <div class="wrap">
      <span class="eyebrow">The bill, itemised</span>
      <h2>Five lines, one of which is fixed.</h2>
      <div class="table-wrap">
        <table class="matrix stack">
          <thead>
            <tr>
              <th scope="col">Line</th>
              <th scope="col">Cost</th>
              <th scope="col">What it is</th>
            </tr>
          </thead>
          <tbody>
            {
              LINE_ITEMS.map((l) => (
                <tr>
                  <th scope="row">{l.item}</th>
                  <td class="mine" data-label="Cost">{l.cost}</td>
                  <td data-label="What it is">{l.note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="notice" style="margin-top: 1.5rem">
        <p>
          <strong>We are not going to invent a monthly total for you.</strong> Every "typical bill"
          figure on a page like this is a guess dressed up as a measurement, and you find out it was
          wrong on your own invoice. The fixed line is published; the metered lines depend on your
          traffic. <a href={CLOUDFLARE_PRICING} rel="nofollow noopener">Cloudflare's pricing</a> is
          the only source that binds.
        </p>
      </div>

      {/* A "what builds it" logo strip used to sit here. It made no claim this
          page needed: the bill is the argument, and a row of marks under it
          invited the reader to price things that are not on it. It now appears
          once, on /fork, where provenance is the point. */}
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <span class="eyebrow">What deploying involves</span>
      <h2>Four resources, one secret, two commands.</h2>
      <p class="sub">
        Not a caveat. It is the reason the first line of that table is zero.
      </p>
      <div class="two-col">
        <div>
          <ul class="ticks">
            <li>A D1 database, a KV namespace, an R2 bucket and three queues, in your account</li>
            <li>
              One Workers Secret — the key that signs unsubscribe links, so a speaker can leave a
              mailing list without signing in
            </li>
            <li>Your hostname in an environment variable; the app never learns it any other way</li>
            <li>A custom domain on the Worker, which is where your speakers arrive</li>
          </ul>
        </div>
        <div>
          <pre class="term"><code>npm run deploy:migrate
npm run deploy</code></pre>
          <p>
            The first applies every migration to your database, the second puts the Worker up. Both
            read a config generated at deploy time, so there are no account ids in the repository
            you cloned and your first deploy cannot land in somebody else's database.
          </p>
        </div>
      </div>
      <p class="nextstep"><a href="/fork">And what happens when you change it →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">The other half of the price</span>
      <h2>What it costs you that is not money.</h2>
      <p class="sub">
        This is where an open-source tool is genuinely more expensive than a hosted one. Pretending
        otherwise wastes your afternoon and ours.
      </p>
      <div class="cards">
        {
          NOT_MONEY.map((n) => (
            <div class="card reveal">
              <h3>{n.title}</h3>
              <p>{n.body}</p>
            </div>
          ))
        }
      </div>
      <p class="nextstep"><a href="/compare">If that is a dealbreaker, here is what to buy instead →</a></p>
    </div>
  </section>

  <section class="band-dark">
    <div class="wrap">
      <span class="eyebrow">What you never pay for</span>
      <h2>Things that are line items elsewhere.</h2>
      <div class="two-col">
        <ul class="ticks">
          <li>Extra speakers, proposals, reviewers or committee members</li>
          <li>A second event, or last year's archived one</li>
          <li>Additional team seats or admin users</li>
          <li>The API, the webhooks, or a higher rate limit on either</li>
        </ul>
        <ul class="ticks">
          <li>Getting your own data back out</li>
          <li>Single sign-on, when the adapter exists</li>
          <li>A feature held back for a higher tier — there are no tiers</li>
          <li>An activation code per conference occurrence</li>
        </ul>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Questions people actually ask</span>
      <h2>The ones that come up in the second meeting.</h2>
      <div class="faq">
        {
          FAQ.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div class="body">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
      <p class="nextstep"><a href="/security">Where your speakers' data lives →</a></p>
    </div>
  </section>

  <Cta
    heading="The cheapest way to find out is to go and use it."
    sub="No card, no form, no trial clock. Sign in as the program chair of a conference that is already halfway through its year."
    secondaryHref={GITHUB_URL}
    secondaryLabel="Read the source first"
  />
</Base>
