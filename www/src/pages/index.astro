---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import Shot from "../components/Shot.astro";
import { DOMAIN_MODEL_URL, GITHUB_URL, STATS } from "../consts";

/*
 * The order of this page is the order the pain arrives in.
 *
 * The README's "six capabilities" list is how the product describes itself to
 * someone deciding whether to read the code. It is not how the problem arrives
 * for the person running the conference — they do not wake up needing "proposal
 * evaluation", they wake up to a reviewer who works with a submitter and a
 * sponsor asking where their second session went. So this page leads with the
 * job and shows the screen that does it; the capability names are still here,
 * one layer down, because that is the vocabulary of the docs they will read next.
 *
 * Since the site went multi-page this page carries the argument and three
 * proofs, not all six: a landing page that says everything is a landing page
 * nobody finishes. The rest is one click away at /features, and every section
 * below ends pointing somewhere specific.
 *
 * Every claim below is either visible in the screenshot beside it or backed by
 * the rule in docs/domain/ that enforces it. Nothing here is aspirational.
 */

const pains = [
  {
    quote: "Who still hasn't sent a bio?",
    answer:
      "A board of every outstanding obligation, per speaker and per sponsor, with the reminders sent for you.",
  },
  {
    quote: "Two reviewers work with the submitter.",
    answer:
      "Conflicts are declared up front and the score is refused, not flagged for someone to catch later.",
  },
  {
    quote: "How many sessions does this sponsor actually get?",
    answer: "Used against bought, counted from the contract, on the same screen as the deal.",
  },
  {
    quote: "Two talks, one room, same slot.",
    answer: "Found by the agenda the moment you place them — not by an attendee on the day.",
  },
  {
    quote: "The website schedule is two versions behind.",
    answer: "Publish a snapshot your marketing site embeds. Roll it back in one click if it is wrong.",
  },
  {
    quote: "Every speaker emails me to ask where their talk stands.",
    answer: "They sign in and see it: status, next action, deadline, and what you still need from them.",
  },
];
---

<Base>
  <div class="hero">
    <div class="glows" aria-hidden="true">
      <div class="glow one"></div>
      <div class="glow two"></div>
    </div>
    <div class="wrap">
      <h1>Your conference program is <span class="hl">eleven spreadsheets</span> and one person who knows where everything is.</h1>
      <p class="lede">
        Podium replaces all of it — the call for proposals, the review, the sponsor sessions, the
        chase for bios and slides, and the schedule that goes on your website. Free, open source,
        and it runs on infrastructure you own.
      </p>
      <div class="actions">
        <a class="btn primary" href="/demo">Try the demo</a>
        <a class="btn secondary" href={GITHUB_URL}>Get the source</a>
      </div>
      <p class="reassure">
        <strong>No per-speaker pricing.</strong> No sales call. No data you cannot export.
      </p>

      <div class="stage">
        <Shot
          name="agenda"
          height={1170}
          url="app.podiumstack.com/admin/events/…/agenda"
          alt="The agenda screen: a room-by-time grid with sessions placed across Main Stage, Room 2A, Room 2B and the Workshop Lab, under a panel naming two conflicts that block publication."
          eager
        />
        <div class="inset">
          <Shot
            name="dashboard"
            height={660}
            small
            alt="An event overview showing counts of days, tracks, formats, rooms and calls for proposals."
          />
        </div>
      </div>
    </div>
  </div>
  <div class="hero-spacer"></div>

  <section>
    <div class="wrap">
      <span class="eyebrow">Sound familiar?</span>
      <h2>The six questions you cannot answer from a spreadsheet.</h2>
      <p class="sub">
        Every one of them is somebody waiting on you. Podium answers all six from one record of
        the program.
      </p>
      <div class="pains">
        {
          pains.map((p) => (
            <div class="pain reveal">
              <q>{p.quote}</q>
              <p>{p.answer}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <span class="eyebrow">What it looks like</span>
      <h2>Three of them, on the running product.</h2>
      <p class="sub">
        These are photographs of Podium against its own seeded conference — a real program
        mid-flight, not a mockup. The other three are on the features page.
      </p>

      <div class="feature reveal">
        <div class="copy">
          <h3>Stop chasing people for bios.</h3>
          <p>
            Say once what an accepted speaker owes you — headshot, bio, slides, code of conduct,
            AV requirements — and Podium tracks every one of them, for every session and every
            sponsor, and sends the reminders itself.
          </p>
          <p>
            Mark a task <em>blocking</em> and an unfinished one keeps that session off the public
            schedule until it is done. You find out now, not on the morning of the event.
          </p>
        </div>
        <Shot
          name="onboarding"
          height={1140}
          url="app.podiumstack.com/admin/events/…/onboarding"
          alt="The onboarding board listing each session against each required task, with an assignee, a status and a due date per row."
        />
      </div>

      <div class="feature flip reveal">
        <div class="copy">
          <h3>Review that holds up when someone asks.</h3>
          <p>
            Reviewers get a queue, a rubric and a progress bar — not a shared sheet with a hundred
            rows. A reviewer who submitted, is credited on, or has declared a conflict with a
            proposal cannot score it: the write is refused, not logged for someone to notice.
          </p>
          <p>
            Run it open, single-blind or double-blind. Every score, comment and decision is
            recorded, so "why was this rejected" has an answer a year later.
          </p>
        </div>
        <Shot
          name="review"
          height={1050}
          url="app.podiumstack.com/review"
          alt="A reviewer's queue: a screening round showing 7 of 7 done, with a card per assigned proposal."
        />
      </div>

      <div class="feature reveal">
        <div class="copy">
          <h3>Sponsor sessions are not an afterthought.</h3>
          <p>
            A sponsor session is paid for, not selected — but it still needs content review, the
            same onboarding and the same slot on the schedule. Most CFP tools model only the call
            for proposals and leave this in email.
          </p>
          <p>
            Here a package is a countable set of entitlements. Two session slots and a logo
            placement; one slot spent, two rights still open — visible to you and to them, so nobody discovers a
            missing slot the week before.
          </p>
        </div>
        <Shot
          name="sponsorships"
          height={840}
          url="app.podiumstack.com/admin/events/…/sponsors"
          alt="A sponsorships table showing three sponsors, their tier, and a progress bar of entitlements used against entitlements bought."
        />
      </div>

      <p class="nextstep"><a href="/features">The full tour: all six screens, and the parts nobody demos →</a></p>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">It talks to the rest of your stack</span>
      <h2>Your email provider, your spreadsheet, your website.</h2>
      <p class="sub">
        Podium sends through <strong>Resend</strong> or <strong>SendGrid</strong>, posts into
        <strong>Slack</strong>, mirrors the program two ways into <strong>Airtable</strong> for the
        people who will never have a login here, and puts your schedule on your own site as a
        cacheable embed. None of it is a vendor lock: the core imports no provider's SDK, so
        swapping one for another is an install and a default.
      </p>
      <div class="cards">
        <div class="card reveal">
          <h3>Mail that is auditable</h3>
          <p>
            Templates, quiet hours, batching and suppression stay on Podium's side of the line —
            the provider only puts the message on the wire. "Did they get the acceptance email?"
            is a query, not a guess.
          </p>
        </div>
        <div class="card reveal">
          <h3>Two-way, without losing an edit</h3>
          <p>
            An edit made in the linked table applies only against the version Podium last pushed.
            If it lost, it is not discarded — it goes into a conflict queue with both values
            showing. Nothing vanishes quietly.
          </p>
        </div>
        <div class="card reveal">
          <h3>An API you can hand out</h3>
          <p>
            A key for your marketing site reads the schedule and cannot read a review or a
            speaker's email address. Personal data is its own scope, off by default, on every
            endpoint.
          </p>
        </div>
      </div>
      <p class="nextstep"><a href="/integrations">Every integration, and the contract behind it →</a></p>
    </div>
  </section>

  <section class="band-dark">
    <div class="wrap">
      <span class="eyebrow">Yours, actually</span>
      <h2>Run it on your own account, or read every line first.</h2>
      <p class="sub">Two things most tools in this category will not let you do.</p>
      <div class="two-col">
        <div>
          <h3>It deploys to infrastructure you own</h3>
          <p>
            Apache-2.0, built for Cloudflare, and it goes to a Cloudflare account in your name with
            your speakers' data in your database. There is no hosted tier to be locked into and no
            price that changes when your conference grows.
          </p>
          <p><a href="/pricing">What it actually costs to run →</a></p>
        </div>

        <div>
          <h3>The rules are written down before the code</h3>
          <p>
            Who may see a reviewer's score, what happens to an unused sponsor slot, what a deadline
            does when it passes — all of it is specified in a normative domain model, and a check in
            CI fails the build when the code and the model disagree.
          </p>
          <p><a href={DOMAIN_MODEL_URL}>Read the domain model →</a></p>
        </div>
      </div>

      <div class="kpis" style="margin-top: 2.75rem">
        <div class="kpi"><b>{STATS.tests}</b><span>tests, unit and integration</span></div>
        <div class="kpi"><b>{STATS.invariants}</b><span>written rules the code enforces</span></div>
        <div class="kpi"><b>{STATS.events}</b><span>events you can subscribe to</span></div>
        <div class="kpi"><b>{STATS.scopes}</b><span>API scopes, personal data its own</span></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">Before you decide</span>
      <h2>It is not the right tool for every conference.</h2>
      <p class="sub">
        Podium does no attendee registration, no badging and no ticketing, and there is no hosted
        tier — somebody has to deploy it once. If that rules it out, the comparison page says so
        plainly and names what to buy instead.
      </p>
      <p class="nextstep"><a href="/compare">Podium against Sessionize and Sessionboard →</a></p>
    </div>
  </section>

  <Cta
    heading="See it with a conference already in it."
    sub="The demo is a three-day event mid-flight — proposals in every state, a review round with real scores, sponsors part-way through their entitlements, an agenda with genuine conflicts — and sign-ins for the chair, a reviewer and a speaker. An empty shell teaches you nothing."
  />
</Base>
