---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import Logos from "../components/Logos.astro";
import Pillars from "../components/Pillars.astro";
import Shot from "../components/Shot.astro";
import { DOMAIN_MODEL_URL, GITHUB_URL, STATS } from "../consts";
import { CONNECTS_TO } from "../data/marks";

/*
 * The order of this page is the order the reader's questions arrive in.
 *
 * The reader is not shopping. They hold a renewal quote for the tool that runs
 * their CFP and they have already decided to leave; what they are estimating is
 * whether the move blows up in the week the call opens. So the page opens on
 * the deployment and the bill — the two things they came to check — and only
 * then argues that the product does the job. It used to open on "eleven
 * spreadsheets and one person who knows where everything is", which is written
 * for somebody drowning in tooling. This reader is not drowning. Their current
 * tool works. It costs five figures and they own none of it.
 *
 * The renewal number itself is deliberately absent, here and everywhere. Most
 * of this category quotes privately, so printing it would be hearsay, and one
 * wrong figure hands the incumbent's sales team the whole page. Our own bill is
 * on it instead, itemised, and the subtraction is left to the reader.
 *
 * Every claim below is either visible in the screenshot beside it or backed by
 * a path in this repository. Nothing here is aspirational. The deploy block is
 * `package.json` scripts and the bindings in `wrangler.jsonc`; the CSV column
 * names are the aliases in `packages/domain/src/content/import.ts`; the four
 * things a CSV can create are that file's `IMPORT_FIELDS` keys, which is also
 * why last year's scores are named as not coming across.
 *
 * Since the site went multi-page this page carries the argument and three
 * proofs, not all six: a landing page that says everything is a landing page
 * nobody finishes. The rest is one click away, and every section below ends
 * pointing somewhere specific.
 */

const pains = [
  {
    quote: "Who still hasn't sent a bio?",
    answer: "One board of what everyone still owes you, per speaker and per sponsor. Reminders go out without you.",
  },
  {
    quote: "Two reviewers work with the submitter.",
    answer: "A declared conflict refuses the score. Nothing is flagged for someone to catch later.",
  },
  {
    quote: "How many sessions does this sponsor actually get?",
    answer: "Used against bought, counted from the contract, on the same screen as the deal.",
  },
  {
    quote: "Two talks, one room, same slot.",
    answer: "The agenda catches it as you drop the card, not an attendee on the day.",
  },
  {
    quote: "The website schedule is two versions behind.",
    answer: "Publish a snapshot your site embeds. Roll it back in one click.",
  },
  {
    quote: "Every speaker emails me to ask where their talk stands.",
    answer: "They sign in and see status, next action, deadline, and what you still need.",
  },
];
---

<Base>
  <div class="hero">
    <div class="glows" aria-hidden="true">
      <div class="glow one"></div>
      <div class="glow two"></div>
    </div>
    <div class="wrap">
      <h1>Run the whole program from <span class="hl">an account in your name</span>.</h1>
      <p class="lede">
        The call for proposals, the review, the sponsor sessions, the chase for bios and slides,
        the schedule your website embeds. MIT-licensed. It deploys to your Cloudflare account, and
        the only bill is Cloudflare's.
      </p>
      <div class="actions">
        <a class="btn primary" href="/demo">Run the demo</a>
        <a class="btn secondary" href={GITHUB_URL}>Get the source</a>
      </div>
      <p class="reassure">
        <strong>No per-speaker pricing.</strong> No seats, no quote, no sales call, and no data you
        cannot export.
      </p>

      <div class="stage">
        <Shot
          name="agenda"
          height={1170}
          phoneName="agenda-phone"
          phoneHeight={1266}
          url="app.podiumstack.com/admin/events/…/agenda"
          alt="The agenda screen: a panel naming two conflicts that block publication, above a room-by-time grid with sessions placed across Main Stage, Room 2A, Room 2B and the Workshop Lab."
          eager
        />
        <div class="inset">
          <Shot
            name="dashboard"
            height={660}
            small
            alt="An event overview showing counts of days, tracks, formats, rooms and calls for proposals."
          />
        </div>
      </div>
    </div>
  </div>
  <div class="hero-spacer"></div>

  <section>
    <div class="wrap">
      <span class="eyebrow">The move</span>
      <h2>Leave in three steps.</h2>
      <p class="sub">
        Deploying is two commands. What costs you is the part that does not come across.
      </p>

      <ol class="steps">
        <li class="reveal">
          <h3>Deploy it into your own account</h3>
          <p>
            A D1 database, a KV namespace, an R2 bucket and three queues, then two commands. The
            hostname is yours, and the app only ever learns it at deploy time.
          </p>
          <pre class="term"><code>npm run deploy:migrate
npm run deploy</code></pre>
        </li>
        <li class="reveal">
          <h3>Bring last year's people in as a CSV</h3>
          <p>
            Columns headed <em>Speaker Name</em>, <em>E-mail</em> and <em>Employer</em> map
            themselves, and you see what will be created, updated and rejected before a row is
            written. People and the roster arrive that way. Last year's sessions, scores and
            decisions do not arrive at all.
          </p>
        </li>
        <li class="reveal">
          <h3>Open the call</h3>
          <p>
            Build the form, publish it, invite the speakers you already know. There is no password
            for a speaker to set: they arrive on a link the event emailed them.
          </p>
        </li>
      </ol>

      <div class="notice" style="margin-top: 2rem">
        <p>
          <strong>Nobody has publicly moved a live conference onto this yet.</strong> The import is
          built and tested; the first migration off a commercial tool is still ahead of us. If it
          is yours, the issue tracker is where it goes.
        </p>
      </div>

      <div class="kpis" style="margin-top: 1.5rem">
        <div class="kpi"><b>$0</b><span>to licence, for every event you will ever run</span></div>
        <div class="kpi"><b>$5</b><span>a month, the one fixed line, on Cloudflare's price list</span></div>
      </div>

      <p class="nextstep"><a href="/compare">What a switch costs, and what has no equivalent here →</a></p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <span class="eyebrow">Sound familiar?</span>
      <h2>The six questions you cannot answer from a spreadsheet.</h2>
      <p class="sub">
        Every one is somebody waiting on you. Podium answers all six from one record of the
        program.
      </p>
      <div class="pains">
        {
          pains.map((p) => (
            <div class="pain reveal">
              <q>{p.quote}</q>
              <p>{p.answer}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <span class="eyebrow">What it looks like</span>
      <h2>Three of them, on the running product.</h2>
      <p class="sub">
        Photographs of Podium against its own seeded conference. The other three are on the
        features page.
      </p>

      <div class="feature reveal">
        <div class="copy">
          <h3>Stop chasing people for bios.</h3>
          <p>
            Say once what an accepted speaker owes you: headshot, bio, slides, code of conduct, AV
            requirements. Podium tracks every one, for sessions and sponsors alike, and sends the
            reminders itself.
          </p>
          <p>
            Mark a task <em>blocking</em> and it keeps that session off the public schedule. You
            find out now, not on the morning of the event.
          </p>
        </div>
        <Shot
          name="onboarding"
          height={1140}
          phoneName="onboarding-phone"
          phoneHeight={975}
          url="app.podiumstack.com/admin/events/…/onboarding"
          alt="The onboarding board: counts of open, blocking, overdue and completed tasks, over a row for each session and each required task with an assignee, a status and a due date."
        />
      </div>

      <div class="feature flip reveal">
        <div class="copy">
          <h3>Review that holds up when someone asks.</h3>
          <p>
            Reviewers get a queue, a rubric and a progress bar. Not a shared sheet with a hundred
            rows. A reviewer who submitted, is credited on, or has declared a conflict with a
            proposal cannot score it — the write is refused, not logged for someone to notice.
          </p>
          <p>
            Run it open, single-blind or double-blind. Every score, comment and decision is
            recorded, so "why was this rejected" has an answer a year later.
          </p>
        </div>
        <Shot
          name="review"
          height={840}
          url="app.podiumstack.com/review"
          alt="A reviewer's queue: a progress bar reading 7 of 7 done, over a card per assigned proposal with its reference, title, track, format, status and due date."
        />
      </div>

      <div class="feature reveal">
        <div class="copy">
          <h3>Sponsor sessions are not an afterthought.</h3>
          <p>
            A sponsor session is paid for, not selected. It still needs content review, onboarding
            and a slot on the schedule. Most CFP tools model the call for proposals and leave this
            half in email.
          </p>
          <p>
            A package is a countable set of entitlements: two session slots and a logo placement,
            one spent, two still open. The sponsor sees the same count you do.
          </p>
        </div>
        <Shot
          name="sponsorships"
          height={840}
          url="app.podiumstack.com/admin/events/…/sponsors"
          alt="A sponsorships table showing three sponsors, their tier, and a progress bar of entitlements used against entitlements bought."
        />
      </div>

      <p class="nextstep"><a href="/features">The full tour: all six screens, and the parts nobody demos →</a></p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <span class="eyebrow">It talks to the rest of your stack</span>
      <h2>Keep your email provider, your spreadsheet and your site.</h2>
      <p class="sub">
        Podium sends through <strong>Resend</strong> or <strong>SendGrid</strong>, posts into
        <strong>Slack</strong>, and mirrors the program two ways into <strong>Airtable</strong>.
        The core imports no provider's SDK, so swapping one for another is an install and a
        default.
      </p>
      <div class="cards">
        <div class="card reveal">
          <h3>Mail you can audit</h3>
          <p>
            Templates, quiet hours, batching and suppression stay on Podium's side; the provider
            only puts the message on the wire. "Did they get the acceptance email?" is a query,
            not a guess.
          </p>
        </div>
        <div class="card reveal">
          <h3>Two-way sync that loses no edit</h3>
          <p>
            An edit in the linked table applies only against the version Podium last pushed. A
            losing edit is not discarded; it goes into a conflict queue showing both values.
          </p>
        </div>
      </div>

      <Logos items={CONNECTS_TO} claim="Adapters you can install today" />

      <p class="nextstep"><a href="/integrations">Every integration, and the contract behind it →</a></p>
    </div>
  </section>

  <Pillars
    eyebrow="Yours, actually"
    heading="Six things that are true before you look at a single screen."
    sub="None of these is a feature. They are consequences of how it is built."
  >
    {/* The event count moved into the sixth pillar above, so it is not repeated
        here — the same number twice in one band reads as padding. */}
    <div class="kpis three" style="margin-top: 2.75rem">
      <div class="kpi"><b>{STATS.tests}</b><span>tests, unit and integration</span></div>
      <div class="kpi"><b>{STATS.endpoints}</b><span>endpoints on one versioned API</span></div>
      <div class="kpi"><b>{STATS.routes}</b><span>routes, each inventoried with its guard</span></div>
    </div>

    <p class="nextstep">
      <a href={DOMAIN_MODEL_URL}>The rules, written down before the code →</a>
    </p>
  </Pillars>

  <section>
    <div class="wrap">
      <span class="eyebrow">Before you decide</span>
      <h2>It is not the right tool for every conference.</h2>
      <p class="sub">
        Podium does no attendee registration, no badging and no ticketing, and there is no hosted
        tier, so somebody deploys it. If that rules it out, the switching page names what to buy
        instead.
      </p>
      <p class="nextstep"><a href="/compare">Podium against Sessionize and Sessionboard →</a></p>
    </div>
  </section>

  <Cta
    heading="See it with a conference already in it."
    sub="A three-day event mid-flight: proposals in every state, real review scores, sponsors part-way through their entitlements, an agenda with conflicts. Sign-ins for the chair, a reviewer and a speaker are on the page."
  />
</Base>
