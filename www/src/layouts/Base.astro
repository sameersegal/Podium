---
import { existsSync } from "node:fs";
import { join } from "node:path";
import "../styles/global.css";
import Analytics from "../components/Analytics.astro";
import NavLinks from "../components/NavLinks.astro";
import {
  APP_URL,
  DOMAIN_MODEL_URL,
  GITHUB_URL,
  IMPLEMENTATION_URL,
  ISSUES_URL,
  LICENSE_URL,
  SIGN_IN_URL,
  SITE_DESCRIPTION,
  SITE_TITLE,
  SOCIAL_HANDLE,
  SOCIAL_URL,
} from "../consts";

interface Props {
  title?: string;
  description?: string;
  /** Skip the canonical tag and ask crawlers to stay away. For the 404 page. */
  noindex?: boolean;
}

const { title, description = SITE_DESCRIPTION, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} — open-source conference program management`;

// `build.format: "file"` in astro.config.mjs means Astro.url.pathname is
// "/index.html", not "/". Emitting that verbatim would point every canonical
// and og:url at a URL nobody links to. Strip it back to the address the page
// is actually served at.
const path = Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, "") || "/";

// Absolute, because Open Graph consumers do not resolve relative URLs. `site`
// is set in astro.config.mjs, so Astro.site is podiumstack.com at build time.
const canonical = new URL(path, Astro.site).href;

// This page's own card, drawn from its eyebrow, headline and lede by
// `scripts/og-cards.mjs` and committed under `public/og/`. Every link the
// project posted used to preview the same logo art.
//
// `/og-image.png` stays the fallback: 404 has no card, and neither does a page
// added before the next run of `npm --prefix www run og`. A card appearing
// needs no change here.
//
// The path is resolved against the working directory rather than against this
// file. Astro bundles the layout into `dist/.prerender/` before running it, so
// `import.meta.url` is a chunk in the output; npm runs a script from its
// package root, so the directory is `www/`. `scripts/check-previews.mjs` fails
// the build when a card is on disk and the page fell back anyway.
const card = `/og/${path === "/" ? "home" : path.replace(/^\//, "")}.jpg`;
const hasCard = existsSync(join(process.cwd(), "public", card));
const ogImage = new URL(hasCard ? card : "/og-image.png", Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    {/* Canonical always points at the apex. www.podiumstack.com is bound as a
        second custom domain on the same Worker rather than redirected — a
        `_redirects` rule cannot match on hostname — so this tag is what stops
        the two hostnames reading as duplicate content. */}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    {/* Icon set and markup from brand/README.md. */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Two, because the site ships two surfaces. A browser that understands
        neither `media` attribute takes the last one, which is the dark
        canvas — the default. */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAF9F6" />
    <meta name="theme-color" content="#0B0C0F" />

    {/* Self-hosted, subsetted and variable — the whole set is 116 KB and none
        of it is a third-party request. Only the two faces above the fold are
        preloaded: the display face sets the headline and the sans sets the
        lede and the buttons under it. The mono and the two italics load in the
        ordinary way, because nothing they set is on the first screen. */}
    <link rel="preload" href="/fonts/newsreader.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/public-sans.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {/* The card is this page's, and it is as far as these tags can go. A
        fragment never reaches the server and crawlers strip it before
        fetching, so /fork#plugin and /fork are one request to Twitterbot and
        would preview identically however these tags were written. That is what
        the share pages under /s/ are for: one static page per section, built
        by `scripts/share-pages.mjs`, carrying that section's heading and card
        and canonical to the real address. They are not pages of this site —
        nothing here links to one — and `npm --prefix www run links` prints the
        one to paste. */}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {/* Both tags carry the same handle: the account is the project, and there is
        no separate author to credit. Unlike og:url these attribute the card
        rather than address the page, so a noindex page still names its source. */}
    <meta name="twitter:site" content={SOCIAL_HANDLE} />
    <meta name="twitter:creator" content={SOCIAL_HANDLE} />

    {/* One script, and it is analytics. Nothing a reader needs runs in the
        browser: the scroll reveal that used to live here hid every section
        until an IntersectionObserver put it back, and content that needs
        JavaScript to become visible can fail to appear, and did, for anyone who
        blocked it. That rule did not move — what moved is "zero scripts", which
        was a proxy for it. Analytics.astro explains what it loads, why it is
        cookieless and what that costs. Anything added beside it has to clear
        the same bar: the page is complete before it runs, and complete if it
        never does. */}
    <Analytics />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    {/* The nav is a row beside the brand where it fits, and a disclosure where
        it does not. It used to be the row at every width, wrapping onto a
        second line at 390px and a third at 320px — a 201px header on the
        narrowest screen, a quarter of it gone before the page started.

        Still no script. `<details>` is the toggle, which means it works with
        scripts blocked, cannot trap focus, and is opened and closed by the
        keyboard without anybody implementing that. `NavLinks` says why the
        links are rendered twice rather than moved between the two. */}
    <header class="topbar">
      <div class="wrap">
        {/* Deliberately not the copy in the repository root `brand/`, which is
            650×192 and 183 KB. This is the same artwork at the size the markup
            actually renders — every byte of the difference was being paid on
            every page load of every page. If the logo is redrawn, both move. */}
        {/* Two wordmarks, one lockup. The gradient mark is unchanged and never
            recoloured; what swaps is the "Podium" text beside it, which is
            white on graphite and near-black on paper. `<picture>` does the
            swap without a script and downloads one file, not two. */}
        <a class="brand" href="/">
          <picture>
            <source srcset="/podium-logo-horizontal.png" media="(prefers-color-scheme: light)" />
            <img src="/podium-logo-horizontal-light.png" alt="Podium" width="325" height="96" />
          </picture>
        </a>
        <nav class="topnav" aria-label="Primary">
          <NavLinks path={path} />
        </nav>
        <a class="btn secondary top-cta" href="/demo">Run the demo</a>
        {/* The accessible name is on the summary, not the icon: a screen reader
            hears "Menu, collapsed" and the browser handles the state, which is
            the whole reason this is a `<details>` and not a button somebody has
            to wire up. */}
        <details class="menu">
          <summary aria-label="Menu">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                d="M4 7h16M4 12h16M4 17h16"
              ></path>
            </svg>
          </summary>
          <nav class="menu-nav" aria-label="Primary">
            <NavLinks path={path} />
          </nav>
        </details>
      </div>
    </header>

    {/* `tabindex="-1"` is what makes the skip link finish its job. Without it the
        jump scrolls the page but leaves focus on <body>, so the next Tab starts
        again from the top of the header — the reader skips the nav and lands
        right back in it. */}
    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <div class="cols">
          {/* The wordmark and one line saying what this is, for the reader who
              landed on an interior page from a search result and scrolled to
              the bottom before they scrolled up. */}
          <div class="brand-col">
            <picture>
              <source srcset="/podium-logo-horizontal.png" media="(prefers-color-scheme: light)" />
              <img src="/podium-logo-horizontal-light.png" alt="Podium" width="325" height="96" loading="lazy" />
            </picture>
            <p>Open-source conference program management. MIT.</p>
          </div>
          <div>
            <h2>Product</h2>
            <a href="/features">Features</a>
            <a href="/integrations">Integrations</a>
            <a href="/pricing">Pricing</a>
            <a href="/security">Security &amp; data</a>
          </div>
          <div>
            <h2>Deciding</h2>
            <a href="/compare">Switching</a>
            <a href="/demo">Run the demo</a>
            <a href={SIGN_IN_URL}>Sign in</a>
          </div>
          {/* Not in the nav: six labels plus the repository is the ceiling and
              the nav is at it. This column is how the guides are found, along
              with the closing link on /pricing, /fork and each other. */}
          <div>
            <h2>Field guides</h2>
            <a href="/guides">All guides</a>
            <a href="/guides/deploy">Deploy to Cloudflare</a>
            <a href="/guides/agents">Run it with an agent</a>
          </div>
          <div>
            <h2>Source</h2>
            <a href="/fork">Fork it</a>
            <a href={GITHUB_URL}>GitHub</a>
            <a href={SOCIAL_URL}>{SOCIAL_HANDLE} on X</a>
            <a href={DOMAIN_MODEL_URL}>Domain model</a>
            <a href={IMPLEMENTATION_URL}>Implementation notes</a>
            <a href={LICENSE_URL}>MIT licence</a>
          </div>
          <div>
            <h2>Help</h2>
            <a href={ISSUES_URL}>Issue tracker</a>
            <a href={`${GITHUB_URL}/issues/new`}>Report a problem</a>
            <a href={APP_URL}>app.podiumstack.com</a>
          </div>
        </div>
        <p class="legal">
          © 2026 Podium · MIT · Unrelated to podium.com (lead management) and to{" "}
          <a href="https://podium-lib.io">podium-lib</a> (micro-frontends), both of which hold the
          obvious namespaces.
        </p>
      </div>
    </footer>
  </body>
</html>
