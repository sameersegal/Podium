---
/**
 * The top of an interior page.
 *
 * The home page has the hero — a dark slab with a screenshot hanging out of the
 * bottom of it. Every other page gets this instead: the same dark ground, no
 * glow, no image, and room for one sentence saying who the page is for. Sharing
 * the ground colour is what keeps the header from looking like it belongs to a
 * different site once you leave the landing page.
 *
 * There was briefly a rail of five pillar labels under the lede here, on the
 * theory that a reader landing on /security from a search result should see
 * what the product is without going home for it. It was five noun phrases —
 * "complete control", "the whole program" — and every one of them would have
 * sat unchanged on a competitor's page, which is the test a line fails when it
 * is not saying anything. The lede does that job, and it is specific.
 */
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<div class="pagehead">
  <div class="wrap">
    <span class="eyebrow">{eyebrow}</span>
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
    <slot />
  </div>
</div>
