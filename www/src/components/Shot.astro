---
/**
 * A product screenshot in a browser frame.
 *
 * Images come from `public/screens/`, regenerated by `npm run screenshots`
 * against the running app. They are captured at 1280 CSS px with a 1.5×
 * device pixel ratio, so the intrinsic width is always 1920 and the intrinsic
 * height is 1.5× the crop height chosen in that script — pass the same number
 * here so the browser reserves the right box and the page does not jump as the
 * images load.
 *
 * `phone` is the exception: those are captured at 390 CSS px, the width the
 * portal is actually read at, so the intrinsic width is 585 and they are framed
 * without the desktop chrome.
 *
 * The frame is a `<div>` inside the `<figure>` rather than being the figure
 * itself, because the frame clips to its own rounded corners and a caption has
 * to sit outside that box.
 *
 * The header bar holds the path and nothing else. It used to draw three
 * coloured dots as well; a browser has traffic lights, a screenshot of one does
 * not need to pretend, and the URL is the part that says which screen this is.
 */
interface Props {
  /** File name in `public/screens/`, without the extension. */
  name: string;
  /** Intrinsic pixel height of the PNG (1.5× the crop height in screenshots.mjs). */
  height: number;
  alt: string;
  /** Shown in the frame's title bar. Omit on small insets, which hide it anyway. */
  url?: string;
  /** Tighter chrome, for the inset in the hero. */
  small?: boolean;
  /** A phone-width capture: 585 intrinsic px wide, no title bar. */
  phone?: boolean;
  /**
   * A second capture of the same screen, taken at 390 CSS px, served below
   * 40rem instead of the desktop file.
   *
   * A 1280px admin screen scaled into a 350px column is a grey rectangle: the
   * body text lands at about four CSS pixels. Where the product has a real
   * narrow layout, this swaps in a photograph of that layout instead, and the
   * `<picture>` means a phone downloads one file rather than both. The desktop
   * chrome comes off with it — a browser title bar over a phone layout is a
   * frame lying about what it is holding.
   */
  phoneName?: string;
  /** Intrinsic pixel height of the phone PNG. Its width is always 585. */
  phoneHeight?: number;
  /** The hero shot is above the fold and must not be lazy-loaded. */
  eager?: boolean;
  /** A line under the frame, for what the screenshot cannot say itself. */
  caption?: string;
}

const {
  name,
  height,
  alt,
  url,
  small = false,
  phone = false,
  phoneName,
  phoneHeight,
  eager = false,
  caption,
} = Astro.props;
const width = phone ? 585 : 1920;
const cls = ["shot", small && "sm", phone && "phone", phoneName && "has-phone"].filter(Boolean).join(" ");
---

<figure class="shot-fig">
  <div class={cls}>
    {
      !phone && (
        <div class="shot-bar" aria-hidden="true">
          {url && <span>{url}</span>}
        </div>
      )
    }
    <picture>
      {
        phoneName && (
          <source media="(max-width: 40rem)" srcset={`/screens/${phoneName}.png`} width={585} height={phoneHeight} />
        )
      }
      <img
        src={`/screens/${name}.png`}
        width={width}
        height={height}
        alt={alt}
        loading={eager ? "eager" : "lazy"}
        decoding={eager ? "sync" : "async"}
      />
    </picture>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
