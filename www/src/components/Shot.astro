---
/**
 * A product screenshot in a browser frame.
 *
 * Images come from `public/screens/`, regenerated by `npm run screenshots`
 * against the running app. They are captured at 1280 CSS px with a 1.5×
 * device pixel ratio, so the intrinsic width is always 1920 and the intrinsic
 * height is 1.5× the crop height chosen in that script — pass the same number
 * here so the browser reserves the right box and the page does not jump as the
 * images load.
 */
interface Props {
  /** File name in `public/screens/`, without the extension. */
  name: string;
  /** Intrinsic pixel height of the PNG (1.5× the crop height in screenshots.mjs). */
  height: number;
  alt: string;
  /** Shown in the frame's title bar. Omit on small insets, which hide it anyway. */
  url?: string;
  /** Tighter chrome, for the inset in the hero. */
  small?: boolean;
  /** The hero shot is above the fold and must not be lazy-loaded. */
  eager?: boolean;
}

const { name, height, alt, url, small = false, eager = false } = Astro.props;
const WIDTH = 1920;
---

<figure class={small ? "shot sm" : "shot"}>
  <div class="shot-bar" aria-hidden="true">
    <i></i><i></i><i></i>
    {url && <span>{url}</span>}
  </div>
  <img
    src={`/screens/${name}.png`}
    width={WIDTH}
    height={height}
    alt={alt}
    loading={eager ? "eager" : "lazy"}
    decoding={eager ? "sync" : "async"}
  />
</figure>
