---
import { PILLARS } from "../data/pillars";

/**
 * The six pillars, at the size they are worth.
 *
 * Six equal cards in a shared-hairline grid. They used to be one lead card
 * across the top and five under it, ranked by width, because a reader who takes
 * one thing from the section should take the first one. The ranking is now the
 * reading order and nothing else, which is what a numbered list already means.
 *
 * The abstract art is gone with the lead card. Every other image on this site
 * is a photograph of the running product; those six were wordless renders that
 * carried no part of the claim beside them, and they were composited with
 * `mix-blend-mode: screen` against a band colour that no longer exists. The
 * words and the number do the work now. The files are still in `public/art/`
 * until the interior pages are rebuilt and can say whether they want them.
 */
interface Props {
  eyebrow?: string;
  heading?: string;
  sub?: string;
  /** Kept for callers; nothing in this section is above the fold any more. */
  eager?: boolean;
}

const {
  eyebrow = "Why this one",
  heading = "Six things that are true before you look at a single screen.",
  sub,
} = Astro.props;
---

<section class="pillars-band">
  <div class="wrap">
    <span class="eyebrow">{eyebrow}</span>
    <h2>{heading}</h2>
    {sub && <p class="sub">{sub}</p>}

    <div class="grid-hair three">
      {
        PILLARS.map((p, i) => (
          <div class="pillar">
            <div class="pillar-copy">
              <span class="pillar-n" aria-hidden="true">
                0{i + 1}
              </span>
              <h3>{p.heading}</h3>
              <p>{p.body}</p>
              {p.stat && (
                <p class="pillar-stat">
                  <b>{p.stat.value}</b>
                  <span>{p.stat.unit}</span>
                </p>
              )}
              <p class="jump">
                <a href={p.href}>{p.hrefLabel} →</a>
              </p>
            </div>
          </div>
        ))
      }
    </div>

    {/* Whatever the page wants to close the band with — the counts, a logo
        strip, the link into the model. Kept as a slot so the six pillars read
        identically on every page and only the footer of the band changes. */}
    <slot />
  </div>
</section>
