{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "podium",
  "main": "workers/api/src/index.ts",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // ---------------------------------------------------------------------------
  // Surfaces
  //
  // 09-api-and-integrations.md names four surfaces (public / portal / management /
  // webhooks). They are separated in the code under workers/api/src/surfaces/*,
  // each with its own auth and cache behaviour, and composed into one Worker
  // entry because a single origin is what a self-hosted deployment (and the
  // browser-driven eval harness) needs. Splitting them into separate Workers
  // behind service bindings is a routing change, not a rewrite: no surface
  // imports another's handlers.
  // ---------------------------------------------------------------------------

  "assets": {
    "directory": "./public",
    "binding": "STATIC",
    // `/live/*` is the WebSocket upgrade — worker-first so the handshake is
    // never answered by the asset router. `/live.js` is deliberately *not*
    // listed: the client script is a static asset and should be served from
    // the edge like `/app.css`.
    // `/assets/*` serves an `Asset` row's bytes from R2 (headshots, sponsor
    // logos, public slides) — added alongside the sibling `/files/*` routes
    // it was missing next to.
    "run_worker_first": ["/e/*", "/admin/*", "/portal/*", "/v1/*", "/embed/*", "/live/*", "/integrations/*", "/assets/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "podium",
      "database_id": "local-podium-d1",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    // Published snapshot cache (keyed on content_etag) + the 24h idempotency
    // replay cache (INV-09-7).
    { "binding": "CACHE", "id": "local-podium-cache" }
  ],

  "r2_buckets": [
    { "binding": "ASSETS_BUCKET", "bucket_name": "podium-assets" }
  ],

  "queues": {
    "producers": [
      { "binding": "EVENT_QUEUE", "queue": "podium-events" },
      { "binding": "DELIVERY_QUEUE", "queue": "podium-delivery" }
    ],
    "consumers": [
      {
        "queue": "podium-events",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "podium-dlq"
      },
      {
        "queue": "podium-delivery",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 6,
        "dead_letter_queue": "podium-dlq"
      },
      {
        // The DLQ for both queues above. No `dead_letter_queue` of its own:
        // a message here has already exhausted retries once, and a second
        // DLQ hop would only hide the same failure one layer further away.
        // `runQueueBatch` (consumers/dispatch.ts) always acks these — see
        // consumers/dead-letter.ts for why retrying is not the right move.
        "queue": "podium-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  },

  "durable_objects": {
    "bindings": [
      // One writer per event's schedule — placement writes serialise here
      // (11-cross-cutting.md, "Concurrency").
      { "name": "SCHEDULE_DO", "class_name": "ScheduleDurableObject" },
      // One live-update room per event, holding hibernatable WebSockets. A
      // frame carries no domain data — only {type, subject, occurred_at} — so
      // a socket can never leak PII or cross a review blinding boundary; the
      // client refetches through the normal authorized route. See
      // workers/api/src/durable/room.ts.
      { "name": "ROOM_DO", "class_name": "RoomDurableObject" }
    ]
  },

  // Append only. Editing `v1` would rewrite history the deployed fleet has
  // already applied.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ScheduleDurableObject"] },
    { "tag": "v2", "new_sqlite_classes": ["RoomDurableObject"] }
  ],

  "triggers": {
    // Reminder fan-out, draft-abandonment sweep, confirmation-deadline expiry,
    // entitlement expiry nudges, session `delivered` transition.
    "crons": ["*/15 * * * *"]
  },

  "vars": {
    "ENVIRONMENT": "development",
    "PUBLIC_BASE_URL": "http://localhost:8787"
  },

  // ---------------------------------------------------------------------------
  // UNSUBSCRIBE_SECRET (Workers Secret, not declared here — see
  // packages/data/src/context.ts and contexts/platform/notifications.ts):
  // the HMAC key for signed, no-login unsubscribe links (INV-09-15).
  //
  //   production   `wrangler secret put UNSUBSCRIBE_SECRET -c wrangler.production.jsonc`
  //                required — generating or verifying a link throws without it.
  //   dev / test   optional. A fixed, documented-insecure default is used so
  //                `npm run dev` needs no setup. To exercise the real path
  //                locally, put `UNSUBSCRIBE_SECRET=<anything>` in a `.dev.vars`
  //                file (gitignored; `wrangler dev` loads it automatically —
  //                no change needed in scripts/dev.mjs).
  // ---------------------------------------------------------------------------

  "observability": { "enabled": true },

  "alias": {
    "@podiumstack/domain": "./packages/domain/src",
    "@podiumstack/data": "./packages/data/src",
    "@podiumstack/plugins": "./packages/plugins/src",
    "@podiumstack/web": "./workers/api/src"
  }
}
